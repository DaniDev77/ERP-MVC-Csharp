@model Sistema.Models.Funcao

@{
    ViewData["Title"] = "Editar função";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Editar função", VoltarTexto = "Funções", VoltarUrl = Url.Action("Index") }' />

@* O id vai na rota, porque a action recebe o parâmetro "id" *@
<form asp-action="Edit" asp-route-id="@Model.FuncaoId" class="ui-card form-card">
    <div class="object-header">
        <span class="bubble bubble-lg" aria-hidden="true">@Html.Raw(Icones.Get("funcoes"))</span>
        <div class="object-header-texto">
            <h2>@Visual.NomeFuncao(Model.Name)</h2>
            <div class="object-header-meta"><span>@Html.Raw(Icones.Get("id"))Código @Model.FuncaoId</span></div>
        </div>
    </div>

    <input type="hidden" asp-for="FuncaoId" />
    <partial name="_Form" model="Model" />

    <div class="ui-card-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">@Html.Raw(Icones.Get("ok"))<span>Salvar</span></button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
