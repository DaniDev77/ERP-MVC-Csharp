@model IEnumerable<Sistema.Models.Funcao>

@{
    ViewData["Title"] = "Funções";
}

<div class="page-header">
    <div>
        <h1>Funções</h1>
        <p class="page-sub">Os papéis de quem usa o sistema: ADM, vendedor e usuário padrão.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nova função</a>
</div>

@if (!Model.Any())
{
    <div class="panel"><p class="mb-0 text-muted">Nenhuma função cadastrada.</p></div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Name)</th>
                    <th>@Html.DisplayNameFor(m => m.Descricao)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Descricao</td>
                        <td class="text-end row-actions">
                            <a asp-action="Edit" asp-route-id="@item.FuncaoId">Editar</a>
                            <span class="text-muted mx-1">·</span>
                            <a asp-action="Details" asp-route-id="@item.FuncaoId">Detalhes</a>
                            <span class="text-muted mx-1">·</span>
                            <a asp-action="Delete" asp-route-id="@item.FuncaoId">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
