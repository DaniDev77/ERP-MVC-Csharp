@model IEnumerable<Sistema.Models.Funcao>

@{
    ViewData["Title"] = "Funções";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Funções", Descricao = "Os papéis de quem usa o sistema: ADM, vendedor e usuário padrão.", Icone = "funcoes",
    AcaoTexto = "Nova função", AcaoUrl = Url.Action("Create") }' />

<div class="ui-card table-card">
    @if (!Model.Any())
    {
        <partial name="_EmptyState" model='new EmptyState {
            Imagem = "~/img/vazio-equipe.svg", Titulo = "Nenhuma função cadastrada",
            Texto = "Funções definem o que cada pessoa pode fazer no sistema.",
            AcaoTexto = "Cadastrar função", AcaoUrl = Url.Action("Create") }' />
    }
    else
    {
        <div class="table-wrap">
            <table class="table-ui table-stack">
                <thead>
                    <tr>
                        <th scope="col">Função</th>
                        <th scope="col">@Html.DisplayNameFor(m => m.Descricao)</th>
                        <th scope="col" class="acoes-col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="cell-head">
                                <div class="cell-main">
                                    <span class="bubble bubble-sm" aria-hidden="true">@Html.Raw(Icones.Get("funcoes"))</span>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@item.FuncaoId" class="cell-title">@Visual.NomeFuncao(item.Name)</a>
                                        <span class="cell-sub">Código @item.FuncaoId</span>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Descrição" class="text-2">@item.Descricao</td>
                            <td class="acoes-col">
                                <div class="row-actions">
                                    <a asp-action="Details" asp-route-id="@item.FuncaoId" class="btn btn-ghost btn-icon btn-sm" aria-label="Ver @item.Name" title="Ver detalhes">@Html.Raw(Icones.Get("olho"))</a>
                                    <a asp-action="Edit" asp-route-id="@item.FuncaoId" class="btn btn-ghost btn-icon btn-sm" aria-label="Editar @item.Name" title="Editar">@Html.Raw(Icones.Get("editar"))</a>
                                    <a asp-action="Delete" asp-route-id="@item.FuncaoId" class="btn btn-ghost-danger btn-icon btn-sm" aria-label="Excluir @item.Name" title="Excluir">@Html.Raw(Icones.Get("excluir"))</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
