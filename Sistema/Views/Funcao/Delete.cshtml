@model Sistema.Models.Funcao

@{
    ViewData["Title"] = "Excluir função";
}

<div class="page-header">
    <div>
        <h1>Excluir função</h1>
        <p class="page-sub">Esta ação não pode ser desfeita.</p>
    </div>
</div>

<div class="panel form-card">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <dl class="detail-list">
        <dt>@Html.DisplayNameFor(model => model.Name)</dt>
        <dd>@Model.Name</dd>
        <dt>@Html.DisplayNameFor(model => model.Descricao)</dt>
        <dd>@Model.Descricao</dd>
    </dl>

    @* O id vai na rota, porque a action recebe o parâmetro "id" *@
    <form asp-action="Delete" asp-route-id="@Model.FuncaoId" class="d-flex gap-2 align-items-center mt-3">
        <button type="submit" class="btn btn-danger">Excluir função</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
