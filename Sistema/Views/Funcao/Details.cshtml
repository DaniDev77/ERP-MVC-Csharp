@model Sistema.Models.Funcao

@{
    ViewData["Title"] = "Detalhes da função";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Função", VoltarTexto = "Funções", VoltarUrl = Url.Action("Index") }' />

<div class="ui-card confirm-card">
    <div class="object-header">
        <span class="bubble bubble-lg" aria-hidden="true">@Html.Raw(Icones.Get("funcoes"))</span>
        <div class="object-header-texto">
            <h1>@Visual.NomeFuncao(Model.Name)</h1>
            <div class="object-header-meta"><span>@Html.Raw(Icones.Get("id"))Código @Model.FuncaoId</span></div>
        </div>
    </div>
    <dl class="detail-grid">
        <div><dt>@Html.Raw(Icones.Get("etiqueta"))@Html.DisplayNameFor(m => m.Name)</dt><dd>@Model.Name</dd></div>
        <div><dt>@Html.Raw(Icones.Get("texto"))@Html.DisplayNameFor(m => m.Descricao)</dt><dd>@Model.Descricao</dd></div>
    </dl>
    <div class="ui-card-footer">
        <a asp-action="Delete" asp-route-id="@Model.FuncaoId" class="btn btn-ghost-danger esquerda-btn">@Html.Raw(Icones.Get("excluir"))<span>Excluir</span></a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        <a asp-action="Edit" asp-route-id="@Model.FuncaoId" class="btn btn-primary">@Html.Raw(Icones.Get("editar"))<span>Editar</span></a>
    </div>
</div>
