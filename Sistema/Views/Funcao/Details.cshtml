@model Sistema.Models.Funcao

@{
    ViewData["Title"] = "Detalhes da função";
}

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p class="page-sub">Função de código @Model.FuncaoId</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.FuncaoId" class="btn btn-outline-secondary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar para a lista</a>
    </div>
</div>

<div class="panel form-card">
    <dl class="detail-list mb-0">
        <dt>@Html.DisplayNameFor(model => model.Name)</dt>
        <dd>@Model.Name</dd>
        <dt>@Html.DisplayNameFor(model => model.Descricao)</dt>
        <dd>@Model.Descricao</dd>
    </dl>
</div>
