@model Sistema.Models.Funcao

@{
    ViewData["Title"] = "Nova função";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Nova função", Descricao = "Função define o que cada pessoa pode fazer no sistema.",
    VoltarTexto = "Funções", VoltarUrl = Url.Action("Index") }' />

<form asp-action="Create" class="ui-card form-card">
    <partial name="_Form" model="Model" />
    <div class="ui-card-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">@Html.Raw(Icones.Get("ok"))<span>Salvar função</span></button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
