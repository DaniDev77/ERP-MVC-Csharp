@using System.Globalization
@model Sistema.Models.InicioViewModel
@* Reescrito do zero (home pública v2 · docs/redesign/plano-home-publica-v2.md).
   O QUE MUDOU E POR QUÊ: por decisão do dono (2026-11-13, segunda decisão do dia) a home do visitante
   deixa de ser SÓ o catálogo e volta a ser também página de apresentação. Ela acumula três papéis, nesta
   hierarquia: (1) apresentação institucional da loja — é a MOLDURA da página, a foto que não sai do
   lugar; (2) a vitrine de produtos — é o CORPO, o que o visitante veio ver, e continua igual ao lote
   B10; (3) a divulgação do Sistema — é o FECHO do argumento, com pedaços da interface de verdade.

   Direção de arte: "split stage" (design-taste-frontend, semente 1871475036). Cada capítulo é uma
   grade de duas colunas: à esquerda o PALCO (position: sticky, 100svh, uma foto de acervo), à direita
   a coluna que rola. Quando o capítulo acaba, o palco sai e o do próximo assume — é assim que a foto
   "muda com a seção", SEM UMA LINHA DE JAVASCRIPT.
   A ideia: o balcão de 1916, e o caderno em cima dele, viram a metade fixa da tela — o balcão não sai
   do lugar enquanto o produto, o preço e o sistema passam por ele.

   O QUE NÃO MUDOU (contrato do lote B10, intocado): só Model.Vitrine, Model.VitrineTotal e
   Model.MostrarVitrine. Nada de estoque, EstoqueMinimo, fornecedor, custo, descrição (RV6), ProdutoId
   nem dado de pessoa. A contagem é UM número só. A view não reordena e não filtra a lista (ela vem do
   cache compartilhado do VitrineService, RV3) e não faz nenhuma conta com Preco.

   Casca: Views/Shared/_LayoutVitrine.cshtml. Estilos: wwwroot/css/vitrine.css. Fotos e licenças:
   wwwroot/img/vitrine/README.md.
   SEM JavaScript próprio. O que a tela usa vem do site.js, que já está revisado: o botão de tema
   ([data-tema-alternar]) e a busca da lista ([data-filtro-*]). Sem JavaScript a página vem inteira:
   saem só o botão de tema e o campo de busca, e a lista aparece completa. O movimento é todo CSS
   (animation-timeline: view()), com recuo para prefers-reduced-motion. *@
@{
    // =====================================================================================
    // EDITE AQUI: o contato da loja no rodapé.
    // =====================================================================================

    // E-mail de contato da loja, mostrado no rodapé. VAZIO = o rodapé não mostra e-mail nenhum.
    // Começa vazio de propósito: um endereço de exemplo numa página pública é pior que nenhum.
    var emailVendas = "";
    // Mostra o link "Privacidade" no rodapé (ligue quando a página de privacidade estiver escrita)
    var mostrarPrivacidade = false;
    // ================================ fim do EDITE AQUI ==================================

    // ---------- Daqui para baixo é só montagem: não precisa editar ----------
    var pt = new CultureInfo("pt-BR");
    // A contagem é UM número só (decisão do dono): só produto com estoque aparece, então todo produto
    // da página está à venda — não existe "N produtos · M disponíveis" e não existe VitrineDisponiveis
    var total = Model.VitrineTotal;
    var mostrados = Model.Vitrine.Count;
    // Com mais produtos à venda do que o teto do servidor (60), a página diz que a lista está cortada
    // (RV9: sem paginação numa página anônima)
    var listaCortada = total > mostrados;
    var palavraTotal = total == 1 ? "produto à venda" : "produtos à venda";
}

@* ===================================================================================================
   CAPÍTULO 1 · CAPA — apresentação institucional
   Campo escuro inteiro (--vitrine-palco). Palco: a fachada da Casa Atlas, Rua da Carioca. A coluna
   traz o acesso no topo, a frase do que isto é e a marca em tamanho de monumento (o h1 da página).
   =================================================================================================== *@
<section class="v-cap v-capa" aria-labelledby="capa-marca">
    @* O palco é sticky e fica 100svh: a foto não sai do lugar enquanto a coluna rola.
       A foto da capa é a única SEM loading="lazy": ela é a primeira dobra *@
    <div class="v-palco">
        <figure class="v-palco-foto v-palco-foto-veu">
            <img src="~/img/vitrine/loja-rua-da-carioca.jpg" width="960" height="1267" fetchpriority="high" decoding="async"
                 alt="Fachada de uma loja de calçados no térreo de um sobrado ornamentado, com as vitrines cheias e pedestres parados na calçada. Fotografia antiga, em preto e branco." />
            <figcaption>Loja de calçados Casa Atlas, Rua da Carioca, Rio de Janeiro</figcaption>
        </figure>
    </div>

    <div class="v-coluna v-capa-coluna">
        @* Cabeçalho: sem logo no topo (a marca gigante embaixo é o logo). Quatro links e uma ação, na
           ordem do HTML = ordem visual = ordem de Tab. O botão de tema fecha a linha *@
        <nav class="v-topo" aria-label="Principal">
            <a href="#catalogo">Produtos</a>
            <a href="#sistema">O Sistema</a>
            <a class="v-entrar" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
            @* "Criar conta" é a ação única do topo. Quem cria conta pela loja cai como Pendente, e a
               nota do bloco de acesso avisa isso com todas as letras *@
            <a class="btn btn-primary v-criar" asp-area="Identity" asp-page="/Account/Register">Criar conta</a>
            <button type="button" class="icon-btn v-tema" data-tema-alternar aria-pressed="false" aria-label="Usar tema escuro">
                <span class="icone-lua">@Html.Raw(Icones.Get("lua"))</span>
                <span class="icone-sol">@Html.Raw(Icones.Get("sol"))</span>
            </button>
        </nav>

        @* A frase que diz o que isto é. Fica ACIMA da marca e aparece junto com ela: é o que responde
           "que lugar é este?" nos primeiros cinco segundos *@
        <p class="v-capa-frase">Uma loja de balcão. O que está à venda está aqui, com o preço.</p>

        @* A marca em tamanho de monumento é o h1 — o único da página. Ela avança para a esquerda e
           cruza o canto da foto (o véu do palco segura o contraste). O desenho da etiqueta de preço
           entra como glifo da palavra, no tamanho da altura das letras *@
        <h1 class="v-monumento" id="capa-marca">
            <span class="v-monumento-glifo" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path class="logo-tag" d="M2.6 12 7.9 5.5c.4-.45.95-.7 1.55-.7h9.3a2.2 2.2 0 0 1 2.2 2.2v10a2.2 2.2 0 0 1-2.2 2.2h-9.3c-.6 0-1.15-.25-1.55-.7L2.6 12Z" />
                    <circle class="logo-furo" cx="8.6" cy="12" r="1.7" />
                    <path class="logo-linhas" d="M12.6 10h5.2M12.6 14h3.6" />
                </svg>
            </span>sistema</h1>

        @if (total > 0)
        {
            @* A ação principal da primeira tela: leva ao catálogo e já diz quantos produtos têm
               estoque agora — é o mesmo número do bloco de baixo, do mesmo Model.VitrineTotal.
               Fica DEPOIS da marca de propósito: botãozinho colado em cima de um título gigante lê
               como selo de "novidade", que é tique de página genérica. Aqui ele fecha a capa.
               Só aparece com catálogo cheio: "ver 0 produtos" seria caminho para lugar nenhum *@
            <a class="v-capa-acao" href="#catalogo">
                <span>Ver @total @palavraTotal</span>
                @Html.Raw(Icones.Get("seta"))
            </a>
        }
    </div>
</section>

<main id="conteudo" tabindex="-1">

    @* ===============================================================================================
       CAPÍTULO 2 · CATÁLOGO — a vitrine de produtos (o corpo da página)
       Palco: a Tendinha da Mangueira, com as prateleiras lotadas. A coluna é uma LISTA DE PREÇOS —
       sem cartão e sem moldura, como a tabela de preços de uma loja: miniatura, nome, tipo e a
       etiqueta amarela. O chão da coluna é o painel branco, porque o furo da etiqueta de preço é
       pintado com var(--surface) (components.css:433) — as duas coisas andam juntas.
       =============================================================================================== *@
    <section class="v-cap v-catalogo" id="catalogo" aria-labelledby="catalogo-titulo">
        <div class="v-palco">
            <figure class="v-palco-foto">
                <img src="~/img/vitrine/tendinha-mangueira.jpg" width="900" height="1200" loading="lazy" decoding="async"
                     alt="Interior de um armazém antigo: prateleiras lotadas de potes, garrafas e caixas, uma caixa registradora e fregueses encostados no balcão. Fotografia antiga, em preto e branco." />
                <figcaption>Tendinha, armazém de secos e molhados na Mangueira, Rio de Janeiro, 1926</figcaption>
            </figure>
        </div>

        <div class="v-coluna v-catalogo-coluna">
            <div class="v-catalogo-cab">
                <h2 id="catalogo-titulo" class="v-titulo">Produtos à venda</h2>

                @if (total > 0)
                {
                    <div class="v-catalogo-linha">
                        @* A contagem segue o que está à vista: o site.js reescreve este mesmo elemento ao
                           filtrar, com as palavras de data-singular/data-plural *@
                        <p class="v-catalogo-conta num" id="contagemVitrine" data-singular="produto à venda" data-plural="produtos à venda" aria-live="polite">@total @palavraTotal</p>
                        @* A coisa viva da página: a busca filtra a lista real da loja no navegador, pelo
                           data-filtro de cada linha (nome + tipo; a descrição não vem para a página
                           pública, RV6). Sem JavaScript o campo não aparece (regra html:not(.js) no
                           vitrine.css) e a lista continua inteira *@
                        <div class="v-busca input-icon">
                            @Html.Raw(Icones.Get("buscar"))
                            <input type="search" class="form-control" placeholder="Buscar produto" aria-label="Buscar produto no catálogo"
                                   data-filtro-alvo="#listaVitrine" data-filtro-vazio="#semProdutoVitrine" data-filtro-contagem="#contagemVitrine" />
                        </div>
                    </div>
                }

                @* A nota de acesso é condição permanente do sistema (conta nova não compra até um ADM
                   liberar), não aviso de ocorrência — por isso é texto, e não alerta com ícone *@
                <p class="v-catalogo-nota">Para comprar, entre na sua conta. Conta nova começa sem função: um administrador da loja libera a compra.</p>
            </div>

            @if (total == 0)
            {
                @* Estado vazio: com o recorte por estoque, catálogo vazio quer dizer "sem produto
                   cadastrado OU sem estoque". O texto cobre os dois casos sem citar número de estoque *@
                <partial name="_EmptyState" model='new EmptyState {
                    Imagem = "~/img/vazio-caixas.svg",
                    Titulo = "Nenhum produto à venda agora",
                    Texto = "Quando a loja cadastrar produtos e tiver estoque, eles aparecem aqui.",
                    AcaoTexto = "Entrar", AcaoIcone = "perfil",
                    AcaoUrl = Url.Page("/Account/Login", new { area = "Identity" }) }' />
            }
            else
            {
                @* Lista semântica (ul/li com role=list) para o leitor de tela anunciar "lista com N itens".
                   A linha NÃO é link: não existe tela pública de produto, e um cartão que cai no login
                   seria promessa falsa — por isso a lista não gera nenhuma parada de Tab *@
                <ul class="v-produtos" id="listaVitrine" role="list">
                    @foreach (var item in Model.Vitrine)
                    {
                        <li class="v-produto" data-filtro="@item.Nome @item.Tipo">
                            @* Miniatura de iniciais sobre matiz estável do nome: Produto não tem campo de
                               imagem, então esta é a regra e não a exceção. Decorativa (aria-hidden no
                               partial): a informação está no nome ao lado *@
                            <partial name="_ProdutoThumb" model='new ProdutoThumb { Nome = item.Nome, Tamanho = "thumb-lg" }' />
                            <div class="v-produto-texto">
                                <h3 class="v-produto-nome">@item.Nome</h3>
                                @if (!string.IsNullOrWhiteSpace(item.Tipo))
                                {
                                    @* Tipo é string? no contrato: nulo OMITE a linha. Nunca escrever
                                       "Sem tipo" na página pública (RV7) — é palavra de tela interna *@
                                    <p class="v-produto-meta">@item.Tipo</p>
                                }
                            </div>
                            @* O preço é a etiqueta amarela da marca — o logo do Sistema é uma etiqueta de
                               preço, e na vitrine ela vira o preço de cada produto. SÓ formatação:
                               decimal 18,2 com "C2", sem conversão para double e sem conta no Razor *@
                            <strong class="etiqueta-preco etiqueta-preco-p num">@item.Preco.ToString("C2", pt)</strong>
                        </li>
                    }
                </ul>

                @* Busca sem resultado: o site.js tira o hidden quando nenhuma linha passa pelo filtro *@
                <div class="sem-resultado" id="semProdutoVitrine" hidden>
                    <img src="~/img/vazio-busca.svg" alt="" width="120" height="85" />
                    Nenhum produto encontrado para essa busca.
                </div>

                @if (listaCortada)
                {
                    @* Aviso de limite (RV9): a lista vem cortada no teto do servidor e a contagem é o
                       total real, então a página diz isso em vez de fingir que mostra tudo *@
                    <p class="v-catalogo-aviso">Mostrando os @mostrados primeiros de @total produtos à venda. Fale com a loja para o catálogo completo.</p>
                }
            }
        </div>
    </section>

    @* ===============================================================================================
       CAPÍTULO 3 · O BALCÃO CONTINUA — a virada do argumento
       Palco: o armazém da família Mury, com o caderno em cima do balcão. A coluna traz o título em
       duas linhas e o texto numa FOLHA DE PAPEL com a borda de baixo recortada: é o cupom da loja, o
       impresso do mundo do assunto. Sem retrato e sem assinatura de pessoa — não há fundador para
       citar, e inventar um seria inventar prova.
       =============================================================================================== *@
    <section class="v-cap v-historia" aria-labelledby="historia-titulo">
        <div class="v-palco">
            <figure class="v-palco-foto">
                <img src="~/img/vitrine/armazem-mury.jpg" width="1600" height="900" loading="lazy" decoding="async"
                     alt="Interior de um armazém antigo: prateleiras cheias de garrafas e caixas, um balcão de madeira com balança e o dono sentado à mesa com papéis e um caderno, ao lado de um menino. Fotografia antiga, em preto e branco." />
                @* A legenda diz o que a foto é. A data vai sem ano de propósito: a própria fonte tem
                   conflito (1916 no nome do arquivo, "por volta de 1930?" no campo Date do Commons) *@
                <figcaption>Armazém da família Mury, Nova Friburgo (RJ), começo do século XX — o caderno está em cima do balcão</figcaption>
            </figure>
        </div>

        <div class="v-coluna v-historia-coluna">
            <h2 class="v-display" id="historia-titulo">O balcão continua,<br />o caderno não</h2>

            <div class="v-cupom">
                <p>Loja é balcão, prateleira e caderno há mais de cem anos. O caderno anotava a venda, o fiado e o que estava para acabar — e era ele que travava tudo quando sumia.</p>
                <p>O que mudou foi só o caderno. A venda sai no balcão e entra no estoque na mesma hora. O pedido que o cliente faz fica esperando a confirmação de quem administra a loja. O mês fecha sem ninguém somar coluna.</p>
                <p>O resto é igual: alguém atrás do balcão, alguém na frente, e uma etiqueta com o preço.</p>
                <p class="v-cupom-fim">Sistema · vendas e estoque</p>
            </div>
            @* A tira destacável do cupom leva a ação, como o canhoto de um recibo leva o telefone *@
            <a class="v-cupom-tira" asp-area="Identity" asp-page="/Account/Login">
                <span>Entrar na minha conta</span>
                @Html.Raw(Icones.Get("seta"))
            </a>
        </div>
    </section>

    @* ===============================================================================================
       CAPÍTULO 4 · O QUE O SISTEMA FAZ — divulgação do software
       Este é o bloco que QUEBRA a divisão e ocupa a largura inteira (a própria direção manda ao menos
       uma seção romper o split, para a página não virar a mesma tela três vezes).
       Os três pedaços de interface são HTML de verdade, com as classes reais do app, marcados com
       data-ui. Dado de exemplo escrito aqui na view: nenhuma consulta nova, nenhum dado do banco,
       nenhum nome de pessoa, e nenhum número de estoque (a decisão do dono vale para a página toda).
       =============================================================================================== *@
    <section class="v-sistema" id="sistema" aria-labelledby="sistema-titulo">
        <div class="v-sistema-grade">
            <h2 class="v-display v-sistema-titulo" id="sistema-titulo">O que o Sistema faz</h2>

            @* ---- Etapa 1: a venda no balcão (retrato, colunas 1-4) ---- *@
            <figure class="v-etapa v-etapa-1">
                <div class="v-fragmento" data-ui>
                    <div class="v-frag-topo">
                        <span class="v-frag-tela">Venda</span>
                        <span class="chip chip-brand">Balcão</span>
                    </div>
                    <ul class="recibo-itens">
                        <li class="recibo-item">
                            <p class="recibo-item-nome">Café moído 500 g</p>
                            <p class="recibo-item-valor">R$ 37,80</p>
                            <p class="recibo-item-sub">2 × R$ 18,90</p>
                        </li>
                        <li class="recibo-item">
                            <p class="recibo-item-nome">Arroz 5 kg</p>
                            <p class="recibo-item-valor">R$ 27,50</p>
                            <p class="recibo-item-sub">1 × R$ 27,50</p>
                        </li>
                        <li class="recibo-item">
                            <p class="recibo-item-nome">Sabão em barra</p>
                            <p class="recibo-item-valor">R$ 9,60</p>
                            <p class="recibo-item-sub">3 × R$ 3,20</p>
                        </li>
                    </ul>
                    <div class="recibo-total"><span>Total</span><strong>R$ 74,90</strong></div>
                    @* A régua mostra o estoque dos três produtos caindo junto com a venda. Sem número:
                       nenhum número de estoque aparece na página pública *@
                    <div class="v-frag-estoque">
                        <span class="v-frag-rot">Estoque dos três itens</span>
                        <span class="regua"><span class="regua-fill" style="width: 62%"></span></span>
                    </div>
                </div>
                <figcaption class="v-etapa-texto">
                    <h3><span class="v-etapa-ordem">No balcão.</span> O vendedor marca os itens, a conta fecha na hora e o estoque desses produtos baixa junto.</h3>
                    <p>Não existe um segundo lugar para anotar depois.</p>
                </figcaption>
            </figure>

            @* ---- Etapa 2: o pedido do cliente (quadrado, colunas 6-8) ---- *@
            <figure class="v-etapa v-etapa-2">
                <div class="v-fragmento" data-ui>
                    <div class="v-frag-topo">
                        <span class="v-frag-tela">Pedidos</span>
                        <span class="contador contador-aberto">1</span>
                    </div>
                    <div class="v-frag-pedido">
                        <p class="cell-title">Pedido 128</p>
                        <p class="cell-sub">3 itens · R$ 74,90</p>
                        <span class="pill pill-alerta">Aguardando confirmação</span>
                    </div>
                    <div class="v-frag-acoes">
                        <span class="btn btn-primary btn-sm">Confirmar</span>
                        <span class="btn btn-ghost btn-sm">Recusar</span>
                    </div>
                </div>
                <figcaption class="v-etapa-texto">
                    <h3><span class="v-etapa-ordem">Pelo site.</span> O cliente monta o pedido na conta dele, e o pedido fica esperando.</h3>
                    <p>Quem administra a loja confirma ou recusa. Só aí ele vira venda e mexe no estoque.</p>
                </figcaption>
            </figure>

            @* ---- Etapa 3: o desempenho por localidade (paisagem, colunas 8-12) ---- *@
            <figure class="v-etapa v-etapa-3">
                <div class="v-fragmento" data-ui>
                    <div class="v-frag-topo">
                        <span class="v-frag-tela">Desempenho por localidade</span>
                        <span class="v-frag-rot">Outubro</span>
                    </div>
                    <ul class="v-frag-uf">
                        <li><span>São Paulo</span><span class="regua"><span class="regua-fill" style="width: 100%"></span></span><span class="num">R$ 4.120,00</span></li>
                        <li><span>Minas Gerais</span><span class="regua"><span class="regua-fill" style="width: 64%"></span></span><span class="num">R$ 2.640,00</span></li>
                        <li><span>Rio de Janeiro</span><span class="regua"><span class="regua-fill" style="width: 48%"></span></span><span class="num">R$ 1.980,00</span></li>
                        <li><span>Bahia</span><span class="regua"><span class="regua-fill" style="width: 32%"></span></span><span class="num">R$ 1.310,00</span></li>
                    </ul>
                </div>
                <figcaption class="v-etapa-texto">
                    <h3><span class="v-etapa-ordem">No fim do mês.</span> O desempenho sai por estado e por cidade, com o mapa do Brasil pintado pelo que cada UF vendeu.</h3>
                    <p>E o que está acabando aparece antes de faltar.</p>
                </figcaption>
            </figure>
        </div>
    </section>

    @* ===============================================================================================
       CAPÍTULO 5 · ACESSO — uma frase e uma ação, e mais nada
       =============================================================================================== *@
    <section class="v-acesso" aria-labelledby="acesso-titulo">
        <div class="v-largura v-acesso-grade">
            <div>
                @* O título É a frase, no tamanho de frase: este bloco não tem tipo de título por
                   desenho — o espaço em volta é que faz o trabalho *@
                <h2 class="v-acesso-frase" id="acesso-titulo">Para comprar, entre na sua conta.</h2>
                <div class="v-acesso-acoes">
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
                    <a class="v-entrar" asp-area="Identity" asp-page="/Account/Register">Criar conta</a>
                </div>
            </div>
            @* O outro lado do bloco não fica vazio: ele responde a única dúvida que trava quem chegou
               agora — "criei a conta, já posso comprar?". É <ol> de verdade porque a ordem importa;
               é a regra real do sistema (conta nova nasce Pendente), não promessa *@
            <ol class="v-acesso-passos">
                <li>Você cria a conta. Ela nasce sem função: dá para entrar, não dá para comprar.</li>
                <li>Um administrador da loja libera a compra para você.</li>
                <li>A partir daí o seu pedido entra na fila da loja, e a loja confirma.</li>
            </ol>
        </div>
    </section>
</main>

@* ===================================================================================================
   RODAPÉ — a marca atravessando a última fotografia
   A foto é o rodapé: sem painel, sem caixa, sem faixa de cor separando. O miolo da imagem é o
   letreiro pintado; o texto só encosta em cima e embaixo, onde o véu segura o contraste.
   =================================================================================================== *@
<footer class="v-rodape" aria-labelledby="rodape-marca">
    <img class="v-rodape-foto" src="~/img/vitrine/rua-da-quitanda.jpg" width="1500" height="844" loading="lazy" decoding="async"
         alt="Rua estreita com uma fileira de lojas de portas fechadas e um letreiro pintado sobre a sacada. Fotografia antiga, em preto e branco." />
    <div class="v-rodape-corpo">
        <div class="v-rodape-topo">
            <nav class="v-rodape-links" aria-label="Rodapé">
                @* aria-current="page": este link aponta para a página em que o visitante já está *@
                <a asp-area="" asp-controller="Home" asp-action="Index" aria-current="page">Produtos</a>
                <a href="#sistema">O Sistema</a>
                <a asp-area="Identity" asp-page="/Account/Login">Entrar</a>
                <a asp-area="Identity" asp-page="/Account/Register">Criar conta</a>
                @* O e-mail só aparece quando o dono preencheu o bloco editável lá em cima *@
                @if (!string.IsNullOrWhiteSpace(emailVendas))
                {
                    <a href="mailto:@emailVendas">@emailVendas</a>
                }
            </nav>
            <p class="v-rodape-oque">Vendas, compras e estoque para loja de balcão.</p>
        </div>

        @* A marca fecha a página em toda a largura. É h2 porque o rodapé é uma seção com texto e
           precisa de um título — e o título natural do fecho é o nome *@
        <h2 class="v-rodape-marca" id="rodape-marca">sistema</h2>
        <p class="v-rodape-ano">
            © @DateTime.Today.Year Sistema
            @if (mostrarPrivacidade)
            {
                <text>· <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a></text>
            }
        </p>
        @* Crédito das fotos: obrigatório para imagem de acervo, mesmo em domínio público. A
           procedência completa (fonte, URL, licença, data e recorte) está em
           wwwroot/img/vitrine/README.md *@
        <p class="v-creditos">
            Fotografias em domínio público, via Wikimedia Commons:
            <a href="https://commons.wikimedia.org/wiki/File:Rua_da_Carioca,_com_destaque_para_a_Loja_de_cal%C3%A7ados_Casa_Atlas,_Acervo_do_Instituto_Moreira_Salles.jpg" rel="noopener">Rua da Carioca</a>,
            acervo do Instituto Moreira Salles;
            <a href="https://commons.wikimedia.org/wiki/File:Tendinha_Armaz%C3%A9m_Secos_e_Molhados_na_Mangueira.jpg" rel="noopener">Tendinha da Mangueira</a>,
            de Raymundo de Castro;
            <a href="https://commons.wikimedia.org/wiki/File:Armaz%C3%A9m_da_Fam%C3%ADlia_Mury_em_1916_-_Nova_Friburgo.jpg" rel="noopener">Armazém da família Mury</a>;
            <a href="https://commons.wikimedia.org/wiki/File:Rua_da_Quitanda_-_3.jpg" rel="noopener">Rua da Quitanda</a>,
            Núcleo de digitalização / IMS.
        </p>
    </div>
</footer>
