@{
    ViewData["Title"] = "Home Page";
}

<div class="py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 mb-3">Bem-vindo ao Sistema</h1>
        <p class="lead text-muted mb-4">Gerencie suas operações com eficiência e segurança</p>
        <hr class="bg-accent my-4" style="border-color: var(--color-accent); height: 2px;">
    </div>

    <div class="row g-4 mt-3">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-people fs-2" style="color: var(--color-accent);"></i>
                    </div>
                    <h5 class="card-title">Usuários</h5>
                    <p class="card-text text-muted">Gerencie usuários do sistema</p>
                    <a asp-area="" asp-controller="Usuario" asp-action="Index" class="btn btn-primary btn-sm">
                        Acessar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-briefcase fs-2" style="color: var(--color-accent);"></i>
                    </div>
                    <h5 class="card-title">Funções</h5>
                    <p class="card-text text-muted">Administre as funções disponíveis</p>
                    <a asp-area="" asp-controller="Funcao" asp-action="Index" class="btn btn-primary btn-sm">
                        Acessar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-truck fs-2" style="color: var(--color-accent);"></i>
                    </div>
                    <h5 class="card-title">Fornecedores</h5>
                    <p class="card-text text-muted">Gerencie seus fornecedores</p>
                    <a asp-area="" asp-controller="Fonecedor" asp-action="Index" class="btn btn-primary btn-sm">
                        Acessar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-box fs-2" style="color: var(--color-accent);"></i>
                    </div>
                    <h5 class="card-title">Produtos</h5>
                    <p class="card-text text-muted">Controle tipos de produtos</p>
                    <a asp-area="" asp-controller="TipoProduto" asp-action="Index" class="btn btn-primary btn-sm">
                        Acessar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 pt-4 border-top" style="border-color: var(--color-border) !important;">
        <p class="text-muted text-center">
            Saiba mais sobre <a href="https://learn.microsoft.com/aspnet/core" target="_blank">desenvolvimento com ASP.NET Core</a>
        </p>
    </div>
</div>
