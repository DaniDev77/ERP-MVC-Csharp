@model Sistema.Models.TipoProduto

@{
    ViewData["Title"] = "Excluir tipo de produto";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Excluir tipo de produto", Descricao = "Confira os dados antes de confirmar.",
    VoltarTexto = "Tipos de produto", VoltarUrl = Url.Action("Index") }' />

<div class="ui-card danger-card confirm-card">
    <div class="object-header">
        <span class="bubble bubble-lg bubble-danger" aria-hidden="true">@Html.Raw(Icones.Get("tipos"))</span>
        <div class="object-header-texto">
            <h2>@Model.TipoNome</h2>
            <div class="object-header-meta"><span>@Model.TipoDescricao</span></div>
        </div>
    </div>

    <div class="danger-zone" role="alert">
        @Html.Raw(Icones.Get("alerta"))
        <div>
            <strong>Esta ação não pode ser desfeita.</strong>
            <p>O tipo <b>@Model.TipoNome</b> será removido do cadastro.</p>
        </div>
    </div>

    <form asp-action="Delete" class="ui-card-footer mt-4">
        <input type="hidden" asp-for="TipoProdutoId" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-danger">@Html.Raw(Icones.Get("excluir"))<span>Excluir tipo</span></button>
    </form>
</div>
