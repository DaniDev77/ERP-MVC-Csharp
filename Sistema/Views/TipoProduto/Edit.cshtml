@model Sistema.Models.TipoProduto

@{
    ViewData["Title"] = "Editar tipo de produto";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Editar tipo de produto", VoltarTexto = "Tipos de produto", VoltarUrl = Url.Action("Index") }' />

<form asp-action="Edit" class="ui-card form-card">
    <div class="object-header">
        @* Tom neutro (slate) no lugar do antigo violeta *@
        <span class="bubble bubble-lg bubble-slate" aria-hidden="true">@Html.Raw(Icones.Get("tipos"))</span>
        <div class="object-header-texto">
            <h2>@Model.TipoNome</h2>
            <div class="object-header-meta"><span>@Html.Raw(Icones.Get("id"))Código @Model.TipoProdutoId</span></div>
        </div>
    </div>

    @* O código fica oculto: é ele que identifica o tipo ao salvar *@
    <input type="hidden" asp-for="TipoProdutoId" />
    <partial name="_Form" model="Model" />

    <div class="ui-card-footer">
        <a asp-action="Delete" asp-route-tipoprodutoid="@Model.TipoProdutoId" class="btn btn-ghost-danger esquerda-btn">@Html.Raw(Icones.Get("excluir"))<span>Excluir</span></a>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">@Html.Raw(Icones.Get("ok"))<span>Salvar alterações</span></button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
