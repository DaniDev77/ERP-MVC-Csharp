@model Sistema.Models.TipoProduto

@{
    ViewData["Title"] = "Detalhes do tipo de produto";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Tipo de produto", VoltarTexto = "Tipos de produto", VoltarUrl = Url.Action("Index") }' />

<div class="ui-card confirm-card">
    <div class="object-header">
        @* Tom neutro (slate) no lugar do antigo violeta *@
        <span class="bubble bubble-lg bubble-slate" aria-hidden="true">@Html.Raw(Icones.Get("tipos"))</span>
        <div class="object-header-texto">
            <h1>@Model.TipoNome</h1>
            <div class="object-header-meta"><span>@Html.Raw(Icones.Get("id"))Código @Model.TipoProdutoId</span></div>
        </div>
    </div>
    <dl class="detail-grid">
        <div><dt>@Html.Raw(Icones.Get("etiqueta"))@Html.DisplayNameFor(m => m.TipoNome)</dt><dd>@Model.TipoNome</dd></div>
        <div><dt>@Html.Raw(Icones.Get("texto"))@Html.DisplayNameFor(m => m.TipoDescricao)</dt><dd>@Model.TipoDescricao</dd></div>
    </dl>
    <div class="ui-card-footer">
        <a asp-action="Delete" asp-route-tipoprodutoid="@Model.TipoProdutoId" class="btn btn-ghost-danger esquerda-btn">@Html.Raw(Icones.Get("excluir"))<span>Excluir</span></a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        @* O código vai na rota com o nome que a action Edit espera: tipoprodutoid *@
        <a asp-action="Edit" asp-route-tipoprodutoid="@Model.TipoProdutoId" class="btn btn-primary">@Html.Raw(Icones.Get("editar"))<span>Editar</span></a>
    </div>
</div>
