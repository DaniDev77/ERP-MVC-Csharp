@model IEnumerable<Sistema.Models.TipoProduto>

@{
    ViewData["Title"] = "Tipos de Produtos";
}

<div class="py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-2">Gerenciar Tipos de Produtos</h1>
            <hr class="bg-accent" style="border-color: var(--color-accent); height: 2px;">
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <a asp-action="Create" class="btn btn-primary btn-lg w-100">
                <i class="bi bi-plus-lg"></i> Novo Tipo
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr class="border-bottom">
                            <th class="px-4 py-3">Nome</th>
                            <th class="px-4 py-3">Descrição</th>
                            <th class="px-4 py-3 text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom align-middle">
                                    <td class="px-4 py-3">
                                        <strong>@Html.DisplayFor(model => item.TipoNome)</strong>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="text-muted">@Html.DisplayFor(model => item.TipoDescricao)</span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <a asp-action="Edit" asp-route-id="@item.TipoProdutoId" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.TipoProdutoId" class="btn btn-sm btn-outline-info" title="Detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.TipoProdutoId" class="btn btn-sm btn-outline-danger" title="Deletar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="px-4 py-4 text-center text-muted">
                                    <p class="mb-0">Nenhum tipo de produto cadastrado ainda.</p>
                                    <a asp-action="Create" class="btn btn-primary btn-sm mt-2">Criar primeiro tipo</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
