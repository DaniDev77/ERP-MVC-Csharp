@model IEnumerable<Sistema.Models.TipoProduto>

@{
    ViewData["Title"] = "Tipos de produto";
}

<div class="page-header">
    <div>
        <h1>Tipos de produto</h1>
        <p class="page-sub">Categorias usadas para organizar os produtos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Novo tipo de produto</a>
</div>

@if (!Model.Any())
{
    <div class="panel"><p class="mb-0 text-muted">Nenhum tipo de produto cadastrado.</p></div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.TipoNome)</th>
                    <th>@Html.DisplayNameFor(m => m.TipoDescricao)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TipoNome</td>
                        <td>@item.TipoDescricao</td>
                        <td class="text-end row-actions">
                            <a asp-action="Edit" asp-route-id="@item.TipoProdutoId">Editar</a>
                            <span class="text-muted mx-1">·</span>
                            <a asp-action="Details" asp-route-id="@item.TipoProdutoId">Detalhes</a>
                            <span class="text-muted mx-1">·</span>
                            <a asp-action="Delete" asp-route-id="@item.TipoProdutoId">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
