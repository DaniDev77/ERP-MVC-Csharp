@model Sistema.Models.TipoProduto

@{
    ViewData["Title"] = "Novo tipo de produto";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Novo tipo de produto", Descricao = "Categorias ajudam a organizar os produtos na lista.",
    VoltarTexto = "Tipos de produto", VoltarUrl = Url.Action("Index") }' />

<form asp-action="Create" class="ui-card form-card">
    <partial name="_Form" model="Model" />
    <div class="ui-card-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">@Html.Raw(Icones.Get("ok"))<span>Salvar tipo</span></button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
