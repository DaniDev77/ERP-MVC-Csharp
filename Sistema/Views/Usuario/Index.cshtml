@model IEnumerable<Sistema.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
}

<div class="page-header">
    <div>
        <h1>Usuários</h1>
        <p class="page-sub">Quem tem conta no sistema e qual é a função de cada um.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Novo usuário</a>
</div>

@if (!Model.Any())
{
    <div class="panel"><p class="mb-0 text-muted">Nenhum usuário cadastrado.</p></div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Name)</th>
                    <th>@Html.DisplayNameFor(m => m.Email)</th>
                    <th>@Html.DisplayNameFor(m => m.Phone)</th>
                    <th>@Html.DisplayNameFor(m => m.CPF)</th>
                    <th>@Html.DisplayNameFor(m => m.Funcao)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>@item.CPF</td>
                        <td><span class="badge-soft">@(item.Funcao?.Name ?? "Sem função")</span></td>
                        <td class="text-end row-actions">
                            <a asp-action="Edit" asp-route-usuarioid="@item.UsuarioId">Editar</a>
                            <span class="text-muted mx-1">·</span>
                            <a asp-action="Details" asp-route-usuarioid="@item.UsuarioId">Detalhes</a>
                            <span class="text-muted mx-1">·</span>
                            <a asp-action="Delete" asp-route-usuarioid="@item.UsuarioId">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
