@model IEnumerable<Sistema.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
    var lista = Model.OrderBy(u => u.FuncaoId != null).ThenBy(u => u.Name).ToList();
    var aguardando = lista.Count(u => u.FuncaoId == null);
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Usuários", Descricao = "Quem usa o sistema e a função de cada um. Só o administrador define a função.", Icone = "usuarios",
    AcaoTexto = "Novo usuário", AcaoUrl = Url.Action("Create") }' />

@if (aguardando > 0)
{
    @* Contas aguardando liberação aparecem primeiro na lista *@
    <div class="alert alert-warning mb-4" role="status">
        @Html.Raw(Icones.Get("espera"))
        <div>
            <strong>@aguardando @(aguardando == 1 ? "conta aguarda" : "contas aguardam") liberação</strong>
            <span class="alert-texto">Defina a função (vendedor ou padrão) para que a pessoa comece a usar o sistema.</span>
        </div>
    </div>
}

<div class="ui-card table-card">
    @if (!lista.Any())
    {
        <partial name="_EmptyState" model='new EmptyState {
            Imagem = "~/img/vazio-equipe.svg", Titulo = "Nenhum usuário cadastrado",
            Texto = "Cadastre quem vai vender ou comprar. Cada pessoa também pode criar a própria conta e aguardar a liberação.",
            AcaoTexto = "Cadastrar primeiro usuário", AcaoUrl = Url.Action("Create") }' />
    }
    else
    {
        <div class="toolbar">
            <div class="busca input-icon">
                @Html.Raw(Icones.Get("buscar"))
                <input type="search" class="form-control" placeholder="Buscar por nome, e-mail ou CPF" aria-label="Buscar usuários"
                       data-filtro-alvo="#tabelaUsuarios" data-filtro-vazio="#semUsuarios" data-filtro-contagem="#contagemUsuarios" />
            </div>
            <span class="toolbar-info" id="contagemUsuarios" data-singular="usuário" data-plural="usuários" aria-live="polite">@lista.Count @(lista.Count == 1 ? "usuário" : "usuários")</span>
        </div>

        <div class="table-wrap">
            <table class="table-ui table-stack" id="tabelaUsuarios">
                <thead>
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Telefone</th>
                        <th scope="col">CPF</th>
                        <th scope="col">Função</th>
                        <th scope="col" class="acoes-col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in lista)
                    {
                        <tr data-filtro="@(u.Name) @(u.Email) @(u.CPF)">
                            <td class="cell-head">
                                <div class="cell-main">
                                    <span class="avatar" style="--h: @Visual.Matiz(u.Name)" aria-hidden="true">@Visual.Iniciais(u.Name)</span>
                                    <div>
                                        <a asp-action="Details" asp-route-usuarioid="@u.UsuarioId" class="cell-title">@u.Name</a>
                                        <span class="cell-sub">@u.Email</span>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Telefone" class="@(string.IsNullOrWhiteSpace(u.Phone) ? "text-3" : "")">@(string.IsNullOrWhiteSpace(u.Phone) ? "—" : u.Phone)</td>
                            <td data-label="CPF" class="mono">@u.CPF</td>
                            <td data-label="Função">@Html.Raw(Pilulas.Funcao(u.FuncaoId, u.Funcao?.Name))</td>
                            <td class="acoes-col">
                                <div class="row-actions">
                                    @if (u.FuncaoId == null)
                                    {
                                        <a asp-action="Edit" asp-route-usuarioid="@u.UsuarioId" class="btn btn-primary btn-sm">@Html.Raw(Icones.Get("chave"))<span>Liberar função</span></a>
                                    }
                                    else
                                    {
                                        <a asp-action="Edit" asp-route-usuarioid="@u.UsuarioId" class="btn btn-ghost btn-icon btn-sm" aria-label="Editar @u.Name" title="Editar">@Html.Raw(Icones.Get("editar"))</a>
                                    }
                                    <a asp-action="Details" asp-route-usuarioid="@u.UsuarioId" class="btn btn-ghost btn-icon btn-sm" aria-label="Ver ficha de @u.Name" title="Ver ficha">@Html.Raw(Icones.Get("olho"))</a>
                                    <a asp-action="Delete" asp-route-usuarioid="@u.UsuarioId" class="btn btn-ghost-danger btn-icon btn-sm" aria-label="Excluir @u.Name" title="Excluir">@Html.Raw(Icones.Get("excluir"))</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="sem-resultado" id="semUsuarios" hidden>
                <img src="~/img/vazio-busca.svg" alt="" width="120" height="85" />
                Nenhum usuário encontrado para essa busca.
            </div>
        </div>
    }
</div>
