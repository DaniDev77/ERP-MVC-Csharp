@using Sistema.Helpers
@model IEnumerable<Sistema.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
    var lista = Model.OrderBy(u => u.FuncaoId != null).ThenBy(u => u.Name).ToList();
    var aguardando = lista.Count(u => u.FuncaoId == null);
}

<div class="page-header">
    <div>
        <h1>Usuários</h1>
        <p class="page-sub">Quem usa o sistema e a função de cada um. Só o administrador define a função.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">@Html.Raw(Icones.Get("mais"))<span>Novo usuário</span></a>
</div>

@if (aguardando > 0)
{
    <div class="aviso" role="status">
        @Html.Raw(Icones.Get("espera"))
        <div>
            <strong>@aguardando @(aguardando == 1 ? "conta aguarda" : "contas aguardam") liberação.</strong>
            <span>Defina a função (vendedor ou padrão) para que a pessoa comece a usar o sistema.</span>
        </div>
    </div>
}

@if (!lista.Any())
{
    <div class="vazio">
        @Html.Raw(Icones.Get("perfil"))
        <h2>Nenhum usuário cadastrado</h2>
        <p>Cadastre quem vai vender ou comprar. Cada pessoa também pode criar a própria conta e aguardar a liberação.</p>
        <a asp-action="Create" class="btn btn-primary">Cadastrar primeiro usuário</a>
    </div>
}
else
{
    <div class="busca">
        @Html.Raw(Icones.Get("buscar"))
        <input type="search" class="form-control" placeholder="Buscar por nome, e-mail ou CPF" aria-label="Buscar usuários" data-filtro-alvo="#tabelaUsuarios" />
    </div>

    <div class="table-wrap">
        <table class="table" id="tabelaUsuarios">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Telefone</th>
                    <th>CPF</th>
                    <th>Função</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in lista)
                {
                    <tr data-filtro="@(u.Name) @(u.Email) @(u.CPF)">
                        <td>
                            <div class="pessoa">
                                <span class="avatar" aria-hidden="true">@(string.Concat(u.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(1).Select(p => p[0])).ToUpperInvariant())</span>
                                <a asp-action="Details" asp-route-usuarioid="@u.UsuarioId" class="nome-link">@u.Name</a>
                            </div>
                        </td>
                        <td>@u.Email</td>
                        <td class="mono">@(string.IsNullOrWhiteSpace(u.Phone) ? "—" : u.Phone)</td>
                        <td class="mono">@u.CPF</td>
                        <td>@Html.Raw(Pilulas.Funcao(u.FuncaoId, u.Funcao?.Name))</td>
                        <td class="text-end row-actions">
                            @if (u.FuncaoId == null)
                            {
                                <a asp-action="Edit" asp-route-usuarioid="@u.UsuarioId" class="btn btn-sm btn-primary">Liberar função</a>
                            }
                            else
                            {
                                <a asp-action="Edit" asp-route-usuarioid="@u.UsuarioId">Editar</a>
                            }
                            <span class="text-muted mx-1">·</span>
                            <a asp-action="Delete" asp-route-usuarioid="@u.UsuarioId" class="text-danger-link">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="sem-resultado" hidden>Nenhum usuário encontrado para essa busca.</p>
    </div>
}
