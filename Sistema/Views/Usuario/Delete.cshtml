@model Sistema.Models.Usuario

@{
    ViewData["Title"] = "Excluir usuário";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Excluir usuário", Descricao = "A pessoa perde o acesso ao sistema. Vendas e compras já registradas continuam no histórico.",
    VoltarTexto = "Usuários", VoltarUrl = Url.Action("Index") }' />

<div class="ui-card danger-card confirm-card">
    <div class="object-header">
        <span class="avatar avatar-lg" style="--h: @Visual.Matiz(Model.Name)" aria-hidden="true">@Visual.Iniciais(Model.Name)</span>
        <div class="object-header-texto">
            <h2>@Model.Name</h2>
            <div class="object-header-meta">@Html.Raw(Pilulas.Funcao(Model.FuncaoId, Model.Funcao?.Name))</div>
        </div>
    </div>

    @* Erro do servidor (ex.: tentar excluir a si mesmo) *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger m-4 mb-0" role="alert"></div>

    <dl class="detail-grid">
        <div><dt>@Html.Raw(Icones.Get("email"))E-mail</dt><dd>@Model.Email</dd></div>
        <div><dt>@Html.Raw(Icones.Get("documento"))CPF</dt><dd class="mono">@Model.CPF</dd></div>
        <div><dt>@Html.Raw(Icones.Get("funcoes"))Função</dt><dd>@(Model.Funcao?.Name ?? "Aguardando liberação")</dd></div>
    </dl>

    <div class="danger-zone" role="alert">
        @Html.Raw(Icones.Get("alerta"))
        <div>
            <strong>Esta ação não pode ser desfeita.</strong>
            <p><b>@Model.Name</b> perde o acesso ao sistema.</p>
        </div>
    </div>

    <form asp-action="Delete" asp-route-usuarioid="@Model.UsuarioId" class="ui-card-footer mt-4">
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-danger">@Html.Raw(Icones.Get("excluir"))<span>Excluir usuário</span></button>
    </form>
</div>
