@model Sistema.Models.Usuario

@{
    ViewData["Title"] = "Excluir usuário";
}

<div class="page-header">
    <div>
        <h1>Excluir @Model.Name?</h1>
        <p class="page-sub">A pessoa perde o acesso ao sistema. Vendas e compras já registradas continuam no histórico.</p>
    </div>
</div>

<div class="panel form-card">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
    <dl class="detail-list">
        <dt>E-mail</dt>
        <dd>@Model.Email</dd>
        <dt>CPF</dt>
        <dd class="mono">@Model.CPF</dd>
        <dt>Função</dt>
        <dd>@(Model.Funcao?.Name ?? "Aguardando liberação")</dd>
    </dl>

    <form asp-action="Delete" asp-route-usuarioid="@Model.UsuarioId" class="acoes mt-4">
        <button type="submit" class="btn btn-danger">Excluir usuário</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
