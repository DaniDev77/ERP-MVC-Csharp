@model Sistema.Models.Usuario

@{
    ViewData["Title"] = "Editar usuário";
    var contaEmail = (string?)ViewBag.ContaEmail;
}

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p class="page-sub">Dados do cadastro e a função de acesso</p>
    </div>
    <a asp-action="Details" asp-route-usuarioid="@Model.UsuarioId" class="btn btn-outline-secondary">Ver ficha</a>
</div>

<div class="layout-form">
    <form asp-action="Edit" asp-route-usuarioid="@Model.UsuarioId" class="panel form-stack">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="UsuarioId" />

        <fieldset class="campos">
            <legend>Dados pessoais</legend>
            <div class="campo">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="campo-linha">
                <div class="campo">
                    <label asp-for="CPF" class="form-label"></label>
                    <input asp-for="CPF" class="form-control" inputmode="numeric" />
                    <span asp-validation-for="CPF" class="text-danger"></span>
                </div>
                <div class="campo">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>
            <div class="campo">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </fieldset>

        <fieldset class="campos">
            <legend>Função</legend>
            <div class="campo">
                <label asp-for="FuncaoId" class="form-label">Função</label>
                <select asp-for="FuncaoId" class="form-select" asp-items="ViewBag.FuncaoId">
                    <option value="">Escolha uma função</option>
                </select>
                <div class="form-text">Vendedor registra vendas. Padrão compra produtos. ADM controla o sistema. Você não pode trocar a sua própria função.</div>
                <span asp-validation-for="FuncaoId" class="text-danger"></span>
            </div>
        </fieldset>

        <div class="acoes">
            <button type="submit" class="btn btn-primary">Salvar alterações</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>

    <aside class="panel conta-vinculo">
        <h2 class="panel-title">Conta de acesso</h2>
        @if (contaEmail != null)
        {
            <div class="aviso aviso-ok">
                @Html.Raw(Sistema.Helpers.Icones.Get("check"))
                <div>
                    <strong>Vinculada</strong>
                    <span class="mono">@contaEmail</span>
                </div>
            </div>
        }
        else
        {
            <div class="aviso aviso-neutro">
                @Html.Raw(Sistema.Helpers.Icones.Get("espera"))
                <div>
                    <strong>Sem conta de acesso</strong>
                    <span>Esta pessoa ainda não consegue entrar. Peça para ela criar a conta e informe o e-mail dela abaixo.</span>
                </div>
            </div>
            <form asp-action="Vincular" method="post" class="mt-3">
                <input type="hidden" name="usuarioid" value="@Model.UsuarioId" />
                <label class="form-label" for="emailConta">E-mail da conta</label>
                <input id="emailConta" name="email" type="email" class="form-control" placeholder="pessoa@empresa.com" required />
                <button type="submit" class="btn btn-outline-secondary w-100 mt-2">Vincular conta</button>
            </form>
        }
    </aside>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
