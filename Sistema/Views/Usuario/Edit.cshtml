@model Sistema.Models.Usuario

@{
    ViewData["Title"] = "Editar usuário";
    var contaEmail = (string?)ViewBag.ContaEmail;
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Editar usuário", VoltarTexto = "Usuários", VoltarUrl = Url.Action("Index"),
    SecundariaTexto = "Ver ficha", SecundariaUrl = Url.Action("Details", new { usuarioid = Model.UsuarioId }), SecundariaIcone = "olho" }' />

<div class="row g-4 align-items-start">
    <div class="col-xl-8">
        <form asp-action="Edit" asp-route-usuarioid="@Model.UsuarioId" class="ui-card">
            <div class="object-header">
                <span class="avatar avatar-lg" style="--h: @Visual.Matiz(Model.Name)" aria-hidden="true">@Visual.Iniciais(Model.Name)</span>
                <div class="object-header-texto">
                    <h2>@Model.Name</h2>
                    <div class="object-header-meta">
                        @Html.Raw(Pilulas.Funcao(Model.FuncaoId, Model.Funcao?.Name))
                        <span>@Html.Raw(Icones.Get("id"))Código @Model.UsuarioId</span>
                    </div>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger m-4 mb-0" role="alert"></div>
            <input type="hidden" asp-for="UsuarioId" />

            <partial name="_DadosPessoais" model="Model" />

            <section class="form-section">
                <div class="form-section-head">
                    @* Tom neutro (slate) no lugar do antigo violeta *@
                    <h2><span class="bubble bubble-sm bubble-slate" aria-hidden="true">@Html.Raw(Icones.Get("funcoes"))</span>Função</h2>
                    <p>Você não pode trocar a sua própria função.</p>
                </div>
                <div>
                    <label asp-for="FuncaoId" class="form-label">Função</label>
                    <div class="input-icon">
                        @Html.Raw(Icones.Get("funcoes"))
                        <select asp-for="FuncaoId" class="form-select" asp-items="ViewBag.FuncaoId">
                            <option value="">Escolha uma função</option>
                        </select>
                    </div>
                    <span class="form-text">Vendedor registra vendas. Padrão compra produtos. ADM controla o sistema.</span>
                    <span asp-validation-for="FuncaoId" class="text-danger"></span>
                </div>
            </section>

            <div class="ui-card-footer">
                <a asp-action="Delete" asp-route-usuarioid="@Model.UsuarioId" class="btn btn-ghost-danger esquerda-btn">@Html.Raw(Icones.Get("excluir"))<span>Excluir</span></a>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">@Html.Raw(Icones.Get("ok"))<span>Salvar alterações</span></button>
            </div>
        </form>
    </div>

    @* Conta de acesso (Identity) vinculada ao cadastro *@
    <div class="col-xl-4">
        <aside class="ui-card">
            <div class="ui-card-header">
                <h2 class="ui-card-title"><span class="bubble bubble-sm bubble-info" aria-hidden="true">@Html.Raw(Icones.Get("link"))</span>Conta de acesso</h2>
            </div>
            <div class="ui-card-body">
                @if (contaEmail != null)
                {
                    <div class="alert alert-success mb-0">
                        @Html.Raw(Icones.Get("check"))
                        <div>
                            <strong>Vinculada</strong>
                            <span class="mono alert-texto">@contaEmail</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        @Html.Raw(Icones.Get("espera"))
                        <div>
                            <strong>Sem conta de acesso</strong>
                            <span class="alert-texto">Esta pessoa ainda não consegue entrar. Peça para ela criar a conta e informe o e-mail dela abaixo.</span>
                        </div>
                    </div>
                    <form asp-action="Vincular" method="post">
                        <input type="hidden" name="usuarioid" value="@Model.UsuarioId" />
                        <label class="form-label" for="emailConta">E-mail da conta</label>
                        <div class="input-icon">
                            @Html.Raw(Icones.Get("email"))
                            <input id="emailConta" name="email" type="email" class="form-control" placeholder="pessoa@empresa.com" required />
                        </div>
                        <button type="submit" class="btn btn-soft w-100 mt-3">@Html.Raw(Icones.Get("link"))<span>Vincular conta</span></button>
                    </form>
                }
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
