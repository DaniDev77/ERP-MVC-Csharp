@using Sistema.Helpers
@model Sistema.Models.Usuario

@{
    ViewData["Title"] = "Ficha do usuário";
}

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p class="page-sub">@Html.Raw(Pilulas.Funcao(Model.FuncaoId, Model.Funcao?.Name))</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-usuarioid="@Model.UsuarioId" class="btn btn-primary">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar para a lista</a>
    </div>
</div>

<div class="layout-form">
    <section class="panel">
        <h2 class="panel-title">Dados do cadastro</h2>
        <dl class="detail-list mb-0">
            <dt>Código</dt>
            <dd class="mono">@Model.UsuarioId</dd>
            <dt>E-mail</dt>
            <dd>@Model.Email</dd>
            <dt>Telefone</dt>
            <dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd>
            <dt>CPF</dt>
            <dd class="mono">@Model.CPF</dd>
            <dt>Função</dt>
            <dd>@(Model.Funcao?.Name ?? "Aguardando liberação")</dd>
        </dl>
    </section>

    <aside class="panel">
        <h2 class="panel-title">Acesso</h2>
        @if (Model.AppUserId == null)
        {
            <p class="text-muted mb-0">Esta pessoa ainda não tem conta de acesso vinculada. Vincule pela edição, usando o e-mail da conta.</p>
        }
        else
        {
            <p class="mb-0">Conta de acesso vinculada. A pessoa entra com o e-mail da conta dela.</p>
        }
    </aside>
</div>
