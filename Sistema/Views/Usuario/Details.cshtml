@model Sistema.Models.Usuario

@{
    ViewData["Title"] = "Ficha do usuário";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Ficha do usuário", VoltarTexto = "Usuários", VoltarUrl = Url.Action("Index") }' />

<div class="row g-4 align-items-start">
    <div class="col-xl-8">
        <section class="ui-card">
            @* Cabeçalho do objeto: avatar grande, nome, função e e-mail *@
            <div class="object-header">
                <span class="avatar avatar-xl" style="--h: @Visual.Matiz(Model.Name)" aria-hidden="true">@Visual.Iniciais(Model.Name)</span>
                <div class="object-header-texto">
                    <h1>@Model.Name</h1>
                    <div class="object-header-meta">
                        @Html.Raw(Pilulas.Funcao(Model.FuncaoId, Model.Funcao?.Name))
                        <span>@Html.Raw(Icones.Get("email"))@Model.Email</span>
                    </div>
                </div>
            </div>
            <dl class="detail-grid">
                <div><dt>@Html.Raw(Icones.Get("id"))Código</dt><dd class="mono">@Model.UsuarioId</dd></div>
                <div><dt>@Html.Raw(Icones.Get("email"))E-mail</dt><dd>@Model.Email</dd></div>
                <div><dt>@Html.Raw(Icones.Get("telefone"))Telefone</dt><dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd></div>
                <div><dt>@Html.Raw(Icones.Get("documento"))CPF</dt><dd class="mono">@Model.CPF</dd></div>
                <div><dt>@Html.Raw(Icones.Get("funcoes"))Função</dt><dd>@(Model.Funcao?.Name != null ? Visual.NomeFuncao(Model.Funcao.Name) : "Aguardando liberação")</dd></div>
            </dl>
            <div class="ui-card-footer">
                <a asp-action="Delete" asp-route-usuarioid="@Model.UsuarioId" class="btn btn-ghost-danger esquerda-btn">@Html.Raw(Icones.Get("excluir"))<span>Excluir</span></a>
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                <a asp-action="Edit" asp-route-usuarioid="@Model.UsuarioId" class="btn btn-primary">@Html.Raw(Icones.Get("editar"))<span>Editar</span></a>
            </div>
        </section>
    </div>

    <div class="col-xl-4">
        <aside class="ui-card">
            <div class="ui-card-body">
                <span class="bubble @(Model.AppUserId == null ? "bubble-warning" : "bubble-success") mb-3" aria-hidden="true">@Html.Raw(Icones.Get(Model.AppUserId == null ? "espera" : "link"))</span>
                <h2 class="ui-card-title mb-2">Acesso</h2>
                @if (Model.AppUserId == null)
                {
                    <p class="text-2 mb-0">Esta pessoa ainda não tem conta de acesso vinculada. Vincule pela edição, usando o e-mail da conta.</p>
                }
                else
                {
                    <p class="text-2 mb-0">Conta de acesso vinculada. A pessoa entra com o e-mail da conta dela.</p>
                }
            </div>
        </aside>
    </div>
</div>
