@model Sistema.Models.Usuario

@{
    ViewData["Title"] = "Criar Novo Usuário";
}

<div class="py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Usuários</a></li>
            <li class="breadcrumb-item active">Criar</li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="mb-2">Criar Novo Usuário</h1>
            <hr class="bg-accent" style="border-color: var(--color-accent); height: 2px;">
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Informações do Usuário</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label">Nome Completo</label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Digite o nome completo" />
                                <span asp-validation-for="Name" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">E-mail</label>
                                <input asp-for="Email" class="form-control form-control-lg" type="email" placeholder="exemplo@email.com" />
                                <span asp-validation-for="Email" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label">Telefone</label>
                                <input asp-for="Phone" class="form-control form-control-lg" placeholder="(XX) XXXXX-XXXX" />
                                <span asp-validation-for="Phone" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CPF" class="form-label">CPF</label>
                                <input asp-for="CPF" class="form-control form-control-lg" placeholder="XXX.XXX.XXX-XX" />
                                <span asp-validation-for="CPF" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Funcao" class="form-label">Função</label>
                                <input asp-for="Funcao" class="form-control form-control-lg" placeholder="Digite a função" />
                                <span asp-validation-for="Funcao" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label">Senha</label>
                                <input asp-for="Password" class="form-control form-control-lg" type="password" placeholder="Digite uma senha segura" />
                                <span asp-validation-for="Password" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AppUserId" class="form-label">ID do Usuário da Aplicação</label>
                                <input asp-for="AppUserId" class="form-control form-control-lg" />
                                <span asp-validation-for="AppUserId" class="invalid-feedback"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="IdentityUser" class="form-label">Usuário Identity</label>
                                <input asp-for="IdentityUser" class="form-control form-control-lg" />
                                <span asp-validation-for="IdentityUser" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4 pt-3 border-top" style="border-color: var(--color-border) !important;">
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-lg"></i> Criar Usuário
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Informações</h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">
                        <strong>Preencha todos os campos corretamente:</strong>
                    </p>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <span style="color: var(--color-success);">✓</span> 
                            Nome completo do usuário
                        </li>
                        <li class="mb-2">
                            <span style="color: var(--color-success);">✓</span> 
                            E-mail válido
                        </li>
                        <li class="mb-2">
                            <span style="color: var(--color-success);">✓</span> 
                            Telefone de contato
                        </li>
                        <li class="mb-2">
                            <span style="color: var(--color-success);">✓</span> 
                            CPF válido
                        </li>
                        <li class="mb-2">
                            <span style="color: var(--color-success);">✓</span> 
                            Função/cargo
                        </li>
                        <li>
                            <span style="color: var(--color-success);">✓</span> 
                            Senha segura
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
