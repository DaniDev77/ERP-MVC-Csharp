@model Sistema.Models.Usuario

@{
    var admin = ViewBag.PodeDefinirFuncao == true;
    ViewData["Title"] = admin ? "Novo usuário" : "Completar cadastro";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = (string)ViewData["Title"]!,
    Descricao = admin ? "Cadastre a pessoa e defina a função dela. A conta de acesso pode ser vinculada depois, pelo e-mail."
                      : "Preencha seus dados. Depois um administrador libera a sua função.",
    VoltarTexto = admin ? "Usuários" : "Meu perfil",
    VoltarUrl = admin ? Url.Action("Index") : Url.Action("Index", "Perfil") }' />

<form asp-action="Create" class="ui-card form-card">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger m-4 mb-0" role="alert"></div>

    <partial name="_DadosPessoais" model="Model" />

    <section class="form-section">
        <div class="form-section-head">
            @* Tom neutro (slate) no lugar do antigo violeta *@
            <h2><span class="bubble bubble-sm bubble-slate" aria-hidden="true">@Html.Raw(Icones.Get("funcoes"))</span>Acesso ao sistema</h2>
            <p>A função define o que a pessoa pode fazer.</p>
        </div>
        <div>
            @if (admin)
            {
                <label asp-for="FuncaoId" class="form-label">Função</label>
                <div class="input-icon">
                    @Html.Raw(Icones.Get("funcoes"))
                    <select asp-for="FuncaoId" class="form-select" asp-items="ViewBag.FuncaoId">
                        <option value="">Escolha uma função</option>
                    </select>
                </div>
                <span class="form-text">Vendedor registra vendas. Padrão compra produtos. ADM controla o sistema.</span>
                <span asp-validation-for="FuncaoId" class="text-danger"></span>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    @Html.Raw(Icones.Get("espera"))
                    <div>
                        <strong>Sua função será definida por um administrador.</strong>
                        <span class="alert-texto">Até lá você pode entrar, mas não consegue vender nem comprar.</span>
                    </div>
                </div>
            }
        </div>
    </section>

    <div class="ui-card-footer">
        @if (admin)
        {
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        }
        else
        {
            <a asp-controller="Perfil" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        }
        <button type="submit" class="btn btn-primary">@Html.Raw(Icones.Get("ok"))<span>@(admin ? "Cadastrar usuário" : "Enviar cadastro")</span></button>
    </div>
</form>
