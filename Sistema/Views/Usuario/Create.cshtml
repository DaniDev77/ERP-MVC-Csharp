@model Sistema.Models.Usuario

@{
    var admin = ViewBag.PodeDefinirFuncao == true;
    ViewData["Title"] = admin ? "Novo usuário" : "Completar cadastro";
}

<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-sub">
            @if (admin)
            {
                <span>Cadastre a pessoa e defina a função dela. A conta de acesso pode ser vinculada depois, pelo e-mail.</span>
            }
            else
            {
                <span>Preencha seus dados. Depois um administrador libera a sua função.</span>
            }
        </p>
    </div>
</div>

<div class="layout-form">
    <form asp-action="Create" class="panel form-stack">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <fieldset class="campos">
            <legend>Dados pessoais</legend>
            <div class="campo">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autocomplete="name" autofocus />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="campo-linha">
                <div class="campo">
                    <label asp-for="CPF" class="form-label"></label>
                    <input asp-for="CPF" class="form-control" inputmode="numeric" placeholder="Somente números" />
                    <span asp-validation-for="CPF" class="text-danger"></span>
                </div>
                <div class="campo">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" placeholder="(11) 99999-9999" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>
            <div class="campo">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </fieldset>

        <fieldset class="campos">
            <legend>Acesso ao sistema</legend>
            @if (admin)
            {
                <div class="campo">
                    <label asp-for="FuncaoId" class="form-label">Função</label>
                    <select asp-for="FuncaoId" class="form-select" asp-items="ViewBag.FuncaoId">
                        <option value="">Escolha uma função</option>
                    </select>
                    <div class="form-text">Vendedor registra vendas. Padrão compra produtos. ADM controla o sistema.</div>
                    <span asp-validation-for="FuncaoId" class="text-danger"></span>
                </div>
            }
            else
            {
                <div class="aviso aviso-neutro">
                    @Html.Raw(Sistema.Helpers.Icones.Get("espera"))
                    <div>
                        <strong>Sua função será definida por um administrador.</strong>
                        <span>Até lá você pode entrar, mas não consegue vender nem comprar.</span>
                    </div>
                </div>
            }
        </fieldset>

        <div class="acoes">
            <button type="submit" class="btn btn-primary">@(admin ? "Cadastrar usuário" : "Enviar cadastro")</button>
            @if (admin)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            }
            else
            {
                <a asp-controller="Perfil" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            }
        </div>
    </form>
</div>
