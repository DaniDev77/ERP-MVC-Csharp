@model EmptyState
@* Estado vazio: título curto, explicação e chamada para ação *@
<div class="empty-state @(Model.Compacto ? "compacto" : "")">
    @* Alterado (redesign B): o bloco vazio mantém o quadro e uma frase; a ilustração só aparece no modo não compacto (primeiro uso) *@
    @if (!Model.Compacto)
    {
        <img src="@Url.Content(Model.Imagem)" alt="" width="96" height="70" loading="lazy" />
    }
    <h2>@Model.Titulo</h2>
    @if (!string.IsNullOrEmpty(Model.Texto))
    {
        <p>@Model.Texto</p>
    }
    @if (Model.AcaoUrl != null || Model.SecundariaUrl != null)
    {
        <div class="acoes">
            @if (Model.AcaoUrl != null)
            {
                <a class="btn btn-primary" href="@Model.AcaoUrl">@Html.Raw(Icones.Get(Model.AcaoIcone))<span>@Model.AcaoTexto</span></a>
            }
            @if (Model.SecundariaUrl != null)
            {
                <a class="btn btn-secondary" href="@Model.SecundariaUrl">@Model.SecundariaTexto</a>
            }
        </div>
    }
</div>
