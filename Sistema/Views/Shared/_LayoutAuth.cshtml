@* Casca das telas de acesso: à esquerda, painel na cor da moldura com a marca, ilustração e a proposta do sistema;
   à direita, o formulário centralizado. No celular, só o formulário numa folha *@
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] · Sistema</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="icon" href="~/img/logo.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Redesign: IBM Plex Sans e Plex Mono, as mesmas fontes da casca principal *@
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#conteudo">Pular para o formulário</a>

    <div class="auth">
        @* ---------- Painel da marca ---------- *@
        <aside class="auth-arte" aria-label="Sobre o sistema">
            <a class="sidebar-marca" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Sistema, página inicial">
                <partial name="_Logo" />
            </a>
            <div class="auth-arte-meio">
                <img src="~/img/login-ilustracao.svg" alt="" width="520" height="360" />
                <div>
                    <h2>Venda, compre e controle o estoque num lugar só.</h2>
                    <p>O balcão, as compras e os números do mês da sua loja, sempre atualizados.</p>
                    <ul class="auth-beneficios">
                        <li>@Html.Raw(Icones.Get("ok"))Vendas registradas em poucos cliques</li>
                        <li>@Html.Raw(Icones.Get("ok"))Alerta automático de estoque baixo</li>
                        <li>@Html.Raw(Icones.Get("ok"))Desempenho por vendedor e por período</li>
                    </ul>
                </div>
            </div>
            <div class="auth-arte-rodape">© @DateTime.Today.Year Sistema · vendas e estoque</div>
        </aside>

        @* ---------- Formulário ---------- *@
        <div class="auth-lado">
            <div class="auth-lado-topo">
                <a class="sidebar-marca" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Sistema, página inicial">
                    <partial name="_Logo" />
                </a>
                <button type="button" class="icon-btn" data-tema-alternar aria-pressed="false" aria-label="Usar tema escuro">
                    <span class="icone-lua">@Html.Raw(Icones.Get("lua"))</span>
                    <span class="icone-sol">@Html.Raw(Icones.Get("sol"))</span>
                </button>
            </div>
            <main class="auth-form-wrap" id="conteudo" tabindex="-1">
                <div class="auth-form-box">
                    @RenderBody()
                </div>
            </main>
            <div class="auth-lado-rodape">Seus dados ficam protegidos: senha com criptografia e bloqueio após tentativas erradas.</div>
        </div>
    </div>

    <partial name="_Toast" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
