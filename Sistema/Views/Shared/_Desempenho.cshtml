@model Sistema.Models.DesempenhoViewModel

@* Filtro de período e totais, compartilhados pelas páginas de desempenho *@
@{
    // Períodos aceitos pela CalcularPeriodo do DesempenhoController
    var periodos = new (string Valor, string Texto)[]
    {
        ("semana", "Semana"), ("mes", "Mês"), ("bimestre", "Bimestre"), ("semestre", "Semestre"), ("ano", "Ano")
    };
    var moeda = new System.Globalization.CultureInfo("pt-BR");
}

<div class="segmented" role="tablist" aria-label="Período">
    @foreach (var (valor, texto) in periodos)
    {
        <a class="@(Model.Periodo == valor ? "active" : "")" asp-action="@ViewBag.Acao" asp-route-periodo="@valor">@texto</a>
    }
</div>

<p class="text-muted mb-3" style="font-size: 13px;">
    De @Model.Inicio.ToString("dd/MM/yyyy") até @Model.Fim.AddDays(-1).ToString("dd/MM/yyyy")
</p>

<div class="faixa-numeros">
    @* Compras só aparecem na página do ADM *@
    @if (ViewBag.MostrarCompras == true)
    {
        <div class="numero">
            <div class="numero-rotulo">Valor em compras</div>
            <div class="numero-valor num">@Model.ValorCompras.ToString("C2", moeda)</div>
            <div class="numero-sub">@Model.QtdCompras compra(s)</div>
        </div>
    }
    <div class="numero">
        <div class="numero-rotulo">Valor em vendas</div>
        <div class="numero-valor num">@Model.ValorVendas.ToString("C2", moeda)</div>
        <div class="numero-sub">@Model.QtdVendas venda(s)</div>
    </div>
    @if (ViewBag.MostrarCompras == true && Model.QtdVendas + Model.QtdCompras > 0)
    {
        <div class="numero">
            <div class="numero-rotulo">Ticket médio de venda</div>
            <div class="numero-valor num">@(Model.QtdVendas > 0 ? (Model.ValorVendas / Model.QtdVendas).ToString("C2", moeda) : "—")</div>
            <div class="numero-sub">valor por venda no período</div>
        </div>
    }
</div>
