@model KpiCard
@* Miolo do card de KPI (usado pelo _KpiCard, com ou sem link) *@
@* Redesign: KPI é tipo, não ladrilho; sai o ícone em bolha colorida e fica só o rótulo acima do número *@
<div class="kpi-topo">
    <span class="kpi-rotulo">@Model.Rotulo</span>
</div>
@* Alterado (redesign B): valor em dinheiro (começa com "R$") em peso 600; contagens ficam em 400. Só apresentação *@
<div class="kpi-valor @(Model.Valor.StartsWith("R$") ? "dinheiro" : "")">@Model.Valor</div>
@if (Model.Rodape != null || Model.Selo != null)
{
    <div class="kpi-rodape">
        @if (Model.Selo != null)
        {
            <span class="chip chip-@Model.SeloTom">@Model.Selo</span>
        }
        @if (Model.Rodape != null)
        {
            <span>@Model.Rodape</span>
        }
    </div>
}
