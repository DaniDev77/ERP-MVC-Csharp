@* Casca do sistema: barra lateral com a navegação de cada função e o conteúdo à direita *@
@using Microsoft.AspNetCore.Authorization
@using Sistema.Authorization
@using Sistema.Helpers
@inject IAuthorizationService AuthorizationService
@{
    // Políticas que decidem o que cada função enxerga no menu (ADM passa em todas as de venda e compra)
    var podeAdmin = (await AuthorizationService.AuthorizeAsync(User, Politicas.Admin)).Succeeded;
    var podeVender = (await AuthorizationService.AuthorizeAsync(User, Politicas.Vendedor)).Succeeded;
    var podeComprar = (await AuthorizationService.AuthorizeAsync(User, Politicas.Padrao)).Succeeded;
    var veMeuDesempenho = (await AuthorizationService.AuthorizeAsync(User, Politicas.SomenteVendedor)).Succeeded;
    var logado = User.Identity?.IsAuthenticated == true;

    // Marca o item do menu da página atual (pelo nome do controller)
    string Ativo(string controller) =>
        string.Equals((string?)ViewContext.RouteData.Values["controller"], controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // Item de navegação: ícone, nome e marcação de página atual, sem repetir o markup
    string Item(string controller, string action, string icone, string rotulo) =>
        $"<a class=\"nav-app-link {Ativo(controller)}\" href=\"{Url.Action(action, controller)}\">{Icones.Get(icone)}<span>{rotulo}</span></a>";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Sistema</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Sistema, início">
                @* Marca própria: três barras de estoque; a azul é o dado principal, a única cor da marca *@
                <svg class="brand-mark" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
                    <rect x="2.5" y="14" width="5" height="11.5" rx="1.5" fill="currentColor" />
                    <rect x="11.5" y="8" width="5" height="17.5" rx="1.5" fill="currentColor" />
                    <rect x="20.5" y="3" width="5" height="22.5" rx="1.5" fill="var(--chart)" />
                </svg>
                <span class="brand-name">Sistema<small>Vendas e estoque</small></span>
            </a>

            <nav aria-label="Menu principal" class="sidebar-nav">
                @if (logado)
                {
                    <div class="nav-group">
                        @Html.Raw(Item("Home", "Index", "inicio", "Início"))
                    </div>
                }

                @* Operação: quem vende, quem compra e o desempenho do vendedor *@
                @if (logado && (podeVender || podeComprar || veMeuDesempenho))
                {
                    <div class="nav-group">
                        <div class="nav-group-title">Operação</div>
                        @if (podeVender)
                        {
                            @Html.Raw(Item("Venda", "Create", "venda", "Venda"))
                        }
                        @if (podeComprar)
                        {
                            @Html.Raw(Item("Compra", "Create", "compra", "Compra"))
                        }
                        @if (veMeuDesempenho)
                        {
                            @Html.Raw(Item("Desempenho", "Vendedor", "desempenho", "Meu desempenho"))
                        }
                    </div>
                }

                @* Estoque e relatórios: só ADM. O aviso de estoque baixo aparece aqui sozinho *@
                @if (podeAdmin)
                {
                    <div class="nav-group">
                        <div class="nav-group-title">Gestão</div>
                        @Html.Raw(Item("Desempenho", "Index", "desempenho", "Desempenho"))
                        @Html.Raw(Item("Produto", "Index", "produtos", "Produtos"))
                        @await Component.InvokeAsync("EstoqueBaixo")
                    </div>
                    <div class="nav-group">
                        <div class="nav-group-title">Cadastros</div>
                        @Html.Raw(Item("Fonecedor", "Index", "fornecedores", "Fornecedores"))
                        @Html.Raw(Item("TipoProduto", "Index", "tipos", "Tipos de produto"))
                        @Html.Raw(Item("Usuario", "Index", "usuarios", "Usuários"))
                        @Html.Raw(Item("Funcao", "Index", "funcoes", "Funções"))
                    </div>
                }
            </nav>

            <div class="sidebar-footer">
                <partial name="_LoginPartial" />
            </div>
        </aside>

        <main class="main" id="conteudo" role="main" tabindex="-1">
            <div class="content-enter">
                @* Confirmação e erros vindos de um redirecionamento: aparecem uma vez, no topo da página *@
                @if (TempData["Sucesso"] is string sucesso)
                {
                    <div class="flash flash-ok" role="status">
                        @Html.Raw(Icones.Get("check"))
                        <span>@sucesso</span>
                    </div>
                }
                @if (TempData["Erro"] is string erro)
                {
                    <div class="flash flash-erro" role="alert">
                        @Html.Raw(Icones.Get("alerta"))
                        <span>@erro</span>
                    </div>
                }
                @RenderBody()
            </div>
            <footer class="site-footer">Sistema · vendas e estoque</footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
