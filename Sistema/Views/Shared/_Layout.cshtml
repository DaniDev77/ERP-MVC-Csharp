@* Serviço de autorização usado para mostrar o menu de ADM só para administradores *@
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Sistema.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Sistema</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @* Links de cadastro só aparecem para ADM (FuncaoId = 1); Usuário foi adicionado ao menu *@
                        @if ((await AuthorizationService.AuthorizeAsync(User, Sistema.Authorization.Politicas.Admin)).Succeeded)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Usuario"
                                   asp-action="Index">Usuário</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Funcao"
                                   asp-action="Index">Função</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Fonecedor"
                                   asp-action="Index">Fornecedor</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="TipoProduto"
                                   asp-action="Index">Tipo Produto</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Produto"
                                   asp-action="Index">Produto</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Desempenho"
                                   asp-action="Index">Desempenho</a>
                            </li>
                        }
                        @* Venda: vendedor (e ADM). Compra: usuário padrão (e ADM). Desempenho do vendedor: só vendedor *@
                        @if ((await AuthorizationService.AuthorizeAsync(User, Sistema.Authorization.Politicas.Vendedor)).Succeeded)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Venda" asp-action="Create">Venda</a>
                            </li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, Sistema.Authorization.Politicas.Padrao)).Succeeded)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Compra" asp-action="Create">Compra</a>
                            </li>
                        }
                        @if ((await AuthorizationService.AuthorizeAsync(User, Sistema.Authorization.Politicas.SomenteVendedor)).Succeeded)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Desempenho" asp-action="Vendedor">Meu Desempenho</a>
                            </li>
                        }
                        @* Aviso de estoque baixo: aparece só para ADM (o componente decide sozinho) *@
                        @await Component.InvokeAsync("EstoqueBaixo")
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Sistema - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
