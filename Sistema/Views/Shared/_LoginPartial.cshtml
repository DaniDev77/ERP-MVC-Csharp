@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@* Rodapé da barra lateral: nome de quem está logado e a saída; para visitantes, entrar e cadastrar *@
@if (SignInManager.IsSignedIn(User))
{
    <div class="user-name mb-1" title="Conta logada">@User.Identity?.Name</div>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        <button type="submit" class="btn-sair">Sair</button>
    </form>
}
else
{
    <div class="d-flex flex-column gap-1">
        <a class="nav-app-link" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
        <a class="nav-app-link" asp-area="Identity" asp-page="/Account/Register">Cadastrar-se</a>
    </div>
}
