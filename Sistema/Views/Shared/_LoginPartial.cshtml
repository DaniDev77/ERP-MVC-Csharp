@using Microsoft.AspNetCore.Identity
@using Sistema.Services
@inject SignInManager<IdentityUser> SignInManager
@inject UsuarioLogadoService UsuarioLogado

@* Alterado (redesign B, D3): linha da conta no rodapé da sidebar (antes ficava no canto da topbar): avatar com iniciais,
   nome e função, e o menu do usuário abrindo para cima; para visitantes, entrar e criar conta *@
@if (SignInManager.IsSignedIn(User))
{
    var usuario = await UsuarioLogado.ObterAsync(User);
    var nome = usuario?.Name ?? User.Identity?.Name ?? "Conta";
    var primeiroNome = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? nome;
    var funcao = usuario?.Funcao?.Name is string f ? Visual.NomeFuncao(f) : "Sem cadastro";

    @* Alterado (redesign B): sai a saudação, que já ficava escondida na topbar antiga *@
    <div class="menu-acoes">
        @* Alterado (redesign B, WCAG 2.5.3): o nome acessível começa pelo texto visível (nome e função) *@
        <button type="button" class="user-btn" data-menu-acoes aria-haspopup="true" aria-expanded="false" aria-controls="menuUsuario" aria-label="@primeiroNome, @funcao: menu da conta">
            <span class="avatar" style="--h: @Visual.Matiz(nome)" aria-hidden="true">@Visual.Iniciais(nome)</span>
            <span class="user-btn-texto">
                <strong>@primeiroNome</strong>
                <span>@funcao</span>
            </span>
            @Html.Raw(Icones.Get("chevron"))
        </button>
        @* Alterado (redesign B): no rodapé da sidebar o menu abre para cima (.abre-cima) *@
        <div class="menu-acoes-lista abre-cima" id="menuUsuario" hidden>
            <div class="menu-acoes-cabeca">
                <strong>@nome</strong>
                <span>@(usuario?.Email ?? User.Identity?.Name)</span>
            </div>
            <a asp-area="" asp-controller="Perfil" asp-action="Index">@Html.Raw(Icones.Get("perfil"))Meu perfil</a>
            <a asp-area="Identity" asp-page="/Account/Manage/Index">@Html.Raw(Icones.Get("id"))Dados da conta</a>
            <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword">@Html.Raw(Icones.Get("cadeado"))Alterar senha</a>
            <hr />
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" data-sem-spinner>
                <button type="submit" class="perigo">@Html.Raw(Icones.Get("sair"))Sair</button>
            </form>
        </div>
    </div>
}
else
{
    <a class="btn btn-secondary btn-sm" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
    <a class="btn btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">Criar conta</a>
}
