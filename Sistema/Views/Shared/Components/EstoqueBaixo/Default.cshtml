@model List<Sistema.Models.Produto>

@* Notificação para o ADM: aparece quando algum produto está com estoque baixo *@
@if (Model.Count > 0)
{
    <li class="nav-item">
        <a class="nav-link text-danger" asp-controller="Produto" asp-action="EstoqueBaixo">
            Estoque baixo <span class="badge bg-danger">@Model.Count</span>
        </a>
    </li>
}
