@model List<Sistema.Models.Produto>

@* Aviso para o ADM: link na barra lateral com a quantidade de produtos com estoque baixo *@
@if (Model.Count > 0)
{
    <a class="nav-app-link estoque-alerta" asp-controller="Produto" asp-action="EstoqueBaixo">
        <span>Estoque baixo</span>
        <span class="nav-count">@Model.Count</span>
    </a>
}
