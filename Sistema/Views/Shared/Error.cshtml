@model ErrorViewModel
@{
    ViewData["Title"] = "Algo deu errado";
}

@* Página de erro: ilustração, explicação curta e caminhos de volta; o código da requisição ajuda o suporte *@
<section class="status-page">
    <img src="~/img/erro.svg" alt="" width="320" height="220" />
    <span class="chip chip-danger">Erro inesperado</span>
    <h1>Algo deu errado por aqui</h1>
    <p>Não conseguimos concluir sua solicitação. Tente de novo em instantes; se o problema continuar, avise o administrador do sistema.</p>
    <div class="status-acoes">
        <a class="btn btn-primary" href="~/">@Html.Raw(Icones.Get("inicio"))<span>Ir para o início</span></a>
    </div>
    @if (Model?.ShowRequestId == true)
    {
        <div class="status-detalhe">Código da requisição: <code>@Model.RequestId</code></div>
    }
</section>
