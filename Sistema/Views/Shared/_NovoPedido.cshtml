@model Sistema.Models.NovoPedidoViewModel
@using System.Globalization
@{
    var moeda = new CultureInfo("pt-BR");
    var produtos = (List<Sistema.Models.Produto>)ViewBag.Produtos;
    var venda = ViewBag.ExigeComprador == true;
}

@* Formulário compartilhado por Venda e Compra: escolhe produtos e quantidades (até 8 linhas).
   O total e o subtotal de cada linha são calculados na tela (site.js); o servidor recalcula ao salvar. *@
<form asp-action="Create" method="post" class="pedido" id="formPedido">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

    @if (venda)
    {
        <div class="pedido-comprador">
            <label asp-for="Comprador" class="form-label">Quem está comprando</label>
            <input asp-for="Comprador" class="form-control" placeholder="CPF ou código do cliente" autocomplete="off" autofocus />
            <div class="form-text">Só clientes com a função Padrão podem comprar. Use o CPF ou o código que aparece na lista de usuários.</div>
            <span asp-validation-for="Comprador" class="text-danger"></span>
        </div>
    }

    <div class="pedido-linhas" role="group" aria-label="Itens do pedido">
        <div class="pedido-cabecalho" aria-hidden="true">
            <span>Produto</span>
            <span class="num">Quantidade</span>
            <span class="num">Subtotal</span>
        </div>

        @for (var i = 0; i < Model.Linhas.Count; i++)
        {
            <div class="pedido-linha" data-linha>
                <div class="pedido-produto">
                    <select asp-for="@Model.Linhas[i].ProdutoId" class="form-select" data-produto aria-label="Produto @(i + 1)">
                        <option value="0">Escolha um produto</option>
                        @foreach (var p in produtos)
                        {
                            <option value="@p.ProdutoId" data-preco="@p.Preco.ToString(CultureInfo.InvariantCulture)" data-estoque="@p.Estoque">
                                @p.Name · @p.Preco.ToString("C2", moeda) · @p.Estoque em estoque
                            </option>
                        }
                    </select>
                </div>
                <div class="pedido-quantidade">
                    @* Linha vazia mostra o campo em branco, não um "0" repetido em cada linha *@
                    <input name="Linhas[@i].Quantidade" id="Linhas_@(i)__Quantidade" class="form-control text-end" type="number" min="0" step="1" inputmode="numeric" placeholder="0" value="@(Model.Linhas[i].Quantidade is > 0 ? Model.Linhas[i].Quantidade.ToString() : "")" data-quantidade aria-label="Quantidade do produto @(i + 1)" />
                </div>
                <div class="pedido-subtotal num" data-subtotal>—</div>
            </div>
        }
    </div>

    <div class="pedido-rodape">
        <div>
            <div class="pedido-total-rotulo">Total</div>
            <div class="pedido-total num" id="pedidoTotal" aria-live="polite">R$ 0,00</div>
            <div class="form-text">Produtos sem estoque não aparecem na lista. Linhas em branco são ignoradas.</div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">@(venda ? "Registrar venda" : "Registrar compra")</button>
    </div>
</form>
