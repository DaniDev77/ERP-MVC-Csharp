@model Sistema.Models.NovoPedidoViewModel

@{
    ViewData["Title"] = "Venda";
}

<h1>Registrar venda</h1>

@* Mensagem de sucesso vinda do redirecionamento após salvar *@
@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success">@sucesso</div>
}

<p class="text-muted">A venda só é registrada para um usuário padrão, e dá baixa no estoque de cada produto.</p>

<partial name="_NovoPedido" model="Model" />
