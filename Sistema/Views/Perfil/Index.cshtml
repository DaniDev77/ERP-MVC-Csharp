@model Sistema.Models.Usuario?

@{
    ViewData["Title"] = "Meu perfil";

    // CPF mostrado parcialmente: só os dois últimos dígitos, para quem olha a tela não ver o número inteiro
    string CpfMascarado(string? cpf)
    {
        var digitos = new string((cpf ?? "").Where(char.IsDigit).ToArray());
        return digitos.Length < 2 ? "•••" : "•••.•••.•••-" + digitos[^2..];
    }
}

<partial name="_PageHeader" model='new PageHeader { Titulo = "Meu perfil", Descricao = "Seus dados de cadastro e o acesso à conta." }' />

@if (Model == null)
{
    @* Conta criada, mas sem cadastro de usuário: o perfil convida a completar *@
    <div class="ui-card confirm-card">
        <partial name="_EmptyState" model='new EmptyState {
            Imagem = "~/img/vazio-equipe.svg", Titulo = "Falta completar o cadastro",
            Texto = "Sua conta já existe, mas ainda não tem dados de usuário no sistema. Complete o cadastro para vender ou comprar.",
            AcaoTexto = "Completar cadastro", AcaoUrl = Url.Action("Create", "Usuario"), AcaoIcone = "id" }' />
    </div>
}
else
{
    @* Capa com gradiente e o avatar sobreposto *@
    <section class="ui-card perfil-card">
        <div class="perfil-capa" aria-hidden="true"></div>
        <div class="perfil-identidade">
            <span class="avatar avatar-xl" style="--h: @Visual.Matiz(Model.Name)" aria-hidden="true">@Visual.Iniciais(Model.Name)</span>
            <div class="perfil-nome">
                <h2>@Model.Name</h2>
                <div class="object-header-meta">
                    @Html.Raw(Pilulas.Funcao(Model.FuncaoId, Model.Funcao?.Name))
                    <span>@Html.Raw(Icones.Get("email"))@Model.Email</span>
                </div>
            </div>
        </div>
    </section>

    @if (Model.FuncaoId == null)
    {
        <div class="alert alert-warning mt-4" role="status">
            @Html.Raw(Icones.Get("espera"))
            <div>
                <strong>Sua função ainda não foi liberada.</strong>
                <span class="alert-texto">Um administrador define se você é vendedor ou comprador. Até lá, venda e compra ficam bloqueadas.</span>
            </div>
        </div>
    }

    <div class="row g-4 mt-0">
        <div class="col-lg-7">
            <section class="ui-card h-100">
                <div class="ui-card-header">
                    <h2 class="ui-card-title"><span class="bubble bubble-sm" aria-hidden="true">@Html.Raw(Icones.Get("id"))</span>Dados do cadastro</h2>
                </div>
                <dl class="detail-grid">
                    <div><dt>@Html.Raw(Icones.Get("telefone"))Telefone</dt><dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd></div>
                    <div><dt>@Html.Raw(Icones.Get("documento"))CPF</dt><dd class="mono">@CpfMascarado(Model.CPF)</dd></div>
                    <div><dt>@Html.Raw(Icones.Get("etiqueta"))Código</dt><dd class="mono">@Model.UsuarioId</dd></div>
                </dl>
            </section>
        </div>
        <div class="col-lg-5">
            <section class="ui-card h-100">
                <div class="ui-card-header">
                    @* Tom neutro (slate) no lugar do antigo violeta *@
                    <h2 class="ui-card-title"><span class="bubble bubble-sm bubble-slate" aria-hidden="true">@Html.Raw(Icones.Get("cadeado"))</span>Acesso à conta</h2>
                </div>
                <div class="ui-card-body">
                    <p class="text-2">Troque o e-mail ou a senha de login. A senha é guardada de forma protegida pelo sistema de acesso.</p>
                    <div class="d-grid gap-2">
                        <a class="btn btn-secondary justify-content-start" asp-area="Identity" asp-page="/Account/Manage/Index">@Html.Raw(Icones.Get("perfil"))<span>Dados da conta</span></a>
                        <a class="btn btn-secondary justify-content-start" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">@Html.Raw(Icones.Get("chave"))<span>Alterar senha</span></a>
                    </div>
                </div>
            </section>
        </div>
    </div>
}
