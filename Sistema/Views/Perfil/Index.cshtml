@model Sistema.Models.Usuario?

@{
    ViewData["Title"] = "Meu perfil";

    // CPF mostrado parcialmente: só os dois últimos dígitos, para quem olha a tela não ver o número inteiro
    string CpfMascarado(string? cpf)
    {
        var digitos = new string((cpf ?? "").Where(char.IsDigit).ToArray());
        return digitos.Length < 2 ? "•••" : "•••.•••.•••-" + digitos[^2..];
    }
}

@* Redesign B (Fase 2, HF-002): a descrição cita também a localização, que virou uma seção do perfil *@
<partial name="_PageHeader" model='new PageHeader { Titulo = "Meu perfil", Descricao = "Seus dados de cadastro, o acesso à conta e a sua localização." }' />

@if (Model == null)
{
    @* Conta criada, mas sem cadastro de usuário: o perfil convida a completar *@
    <div class="ui-card confirm-card">
        <partial name="_EmptyState" model='new EmptyState {
            Imagem = "~/img/vazio-equipe.svg", Titulo = "Falta completar o cadastro",
            Texto = "Sua conta já existe, mas ainda não tem dados de usuário no sistema. Complete o cadastro para vender ou comprar.",
            AcaoTexto = "Completar cadastro", AcaoUrl = Url.Action("Create", "Usuario"), AcaoIcone = "id" }' />
    </div>
}
else
{
    @* Redesign B (Fase 2): sai a capa com gradiente; fica o cabeçalho do objeto direto na folha (avatar, nome, função e e-mail) *@
    <section class="object-header perfil-topo" aria-label="Sua conta">
        <span class="avatar avatar-lg" style="--h: @Visual.Matiz(Model.Name)" aria-hidden="true">@Visual.Iniciais(Model.Name)</span>
        <div class="object-header-texto">
            <h2>@Model.Name</h2>
            <div class="object-header-meta">
                @Html.Raw(Pilulas.Funcao(Model.FuncaoId, Model.Funcao?.Name))
                <span>@Html.Raw(Icones.Get("email"))@Model.Email</span>
            </div>
        </div>
    </section>

    @if (Model.FuncaoId == null)
    {
        <div class="alert alert-warning perfil-aviso" role="status">
            @Html.Raw(Icones.Get("espera"))
            <div>
                <strong>Sua função ainda não foi liberada.</strong>
                <span class="alert-texto">Um administrador define se você é vendedor ou comprador. Até lá, venda e compra ficam bloqueadas.</span>
            </div>
        </div>
    }

    @* Redesign B (Fase 2): configurações em duas colunas, título e descrição à esquerda e o painel à direita;
       empilha abaixo de 1100px. A localização (_Localizacao completo) é a última seção *@
    <div class="config">
        <section class="config-secao" aria-labelledby="titulo-cadastro">
            <div class="config-head">
                <h2 id="titulo-cadastro">Dados do cadastro</h2>
                <p>Seus dados no sistema. O CPF aparece só com os dois últimos dígitos.</p>
            </div>
            <div class="config-painel">
                @* Poço chave-valor; CPF e código em mono *@
                <dl class="detail-grid">
                    <div><dt>@Html.Raw(Icones.Get("telefone"))Telefone</dt><dd>@(string.IsNullOrWhiteSpace(Model.Phone) ? "—" : Model.Phone)</dd></div>
                    <div><dt>@Html.Raw(Icones.Get("documento"))CPF</dt><dd class="mono">@CpfMascarado(Model.CPF)</dd></div>
                    <div><dt>@Html.Raw(Icones.Get("etiqueta"))Código</dt><dd class="mono">@Model.UsuarioId</dd></div>
                </dl>
            </div>
        </section>

        <section class="config-secao" aria-labelledby="titulo-acesso">
            <div class="config-head">
                <h2 id="titulo-acesso">Acesso à conta</h2>
                <p>Troque o e-mail ou a senha de login. A senha é guardada de forma protegida pelo sistema de acesso.</p>
            </div>
            <div class="config-painel">
                @* Links do Identity intactos (asp-area e asp-page) *@
                <div class="config-links">
                    <a class="btn btn-secondary" asp-area="Identity" asp-page="/Account/Manage/Index">@Html.Raw(Icones.Get("perfil"))<span>Dados da conta</span></a>
                    <a class="btn btn-secondary" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">@Html.Raw(Icones.Get("chave"))<span>Alterar senha</span></a>
                </div>
            </div>
        </section>

        @* Novo (back-end, HF-002): localização do usuário, com consentimento. Redesign: entra como seção da mesma grade *@
        @if (ViewBag.Localizacao is Sistema.Models.LocalizacaoViewModel localizacao)
        {
            <partial name="_Localizacao" model="localizacao" />
        }
    </div>
}
