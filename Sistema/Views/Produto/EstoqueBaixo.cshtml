@model IEnumerable<Sistema.Models.Produto>

@{
    ViewData["Title"] = "Estoque baixo";
}

<div class="page-header">
    <div>
        <h1>Estoque baixo</h1>
        <p class="page-sub">Produtos com @Sistema.Models.Produto.EstoqueMinimo unidades ou menos. Abra o produto para repor.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Ver todos os produtos</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-success">Nenhum produto com estoque baixo.</div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Tipo</th>
                    <th>Fornecedor</th>
                    <th class="num">Estoque</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.TipoProduto?.TipoNome</td>
                        <td>@item.Fornecedor?.FonecedorNome</td>
                        <td class="num num-alerta">@item.Estoque</td>
                        <td class="text-end"><a asp-action="Edit" asp-route-id="@item.ProdutoId" class="btn btn-sm btn-primary">Repor estoque</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
