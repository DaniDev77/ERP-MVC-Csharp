@model IEnumerable<Sistema.Models.Produto>

@{
    ViewData["Title"] = "Estoque baixo";
    var minimo = Sistema.Models.Produto.EstoqueMinimo;
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Estoque baixo", Descricao = $"Produtos com {minimo} unidades ou menos. Abra o produto para repor.", Icone = "sino",
    SecundariaTexto = "Ver todos os produtos", SecundariaUrl = Url.Action("Index") }' />

<div class="ui-card table-card">
    @if (!Model.Any())
    {
        <partial name="_EmptyState" model='new EmptyState {
            Imagem = "~/img/tudo-certo.svg", Titulo = "Estoque em dia",
            Texto = "Nenhum produto está no mínimo ou abaixo dele. Bom trabalho!",
            SecundariaTexto = "Ver produtos", SecundariaUrl = Url.Action("Index") }' />
    }
    else
    {
        <div class="table-wrap">
            <table class="table-ui table-stack">
                <thead>
                    <tr>
                        <th scope="col">Produto</th>
                        <th scope="col">Fornecedor</th>
                        <th scope="col">Estoque</th>
                        <th scope="col" class="acoes-col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="cell-head">
                                <div class="cell-main">
                                    <partial name="_ProdutoThumb" model='new ProdutoThumb { Nome = item.Name }' />
                                    <div>
                                        <span class="cell-title">@item.Name</span>
                                        <span class="cell-sub">@(item.TipoProduto?.TipoNome ?? "Sem tipo")</span>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Fornecedor">@(item.Fornecedor?.FonecedorNome ?? "—")</td>
                            @* Redesign: régua de estoque (tique no mínimo) ao lado do selo com o número *@
                            <td data-label="Estoque">
                                <div class="estoque-cel">
                                    <partial name="_ReguaEstoque" model="item.Estoque" />
                                    <span class="chip @(item.Estoque == 0 ? "chip-danger" : "chip-warning")">@(item.Estoque == 0 ? "Sem estoque" : item.Estoque + " un.")</span>
                                </div>
                            </td>
                            <td class="acoes-col">
                                <a asp-action="Edit" asp-route-id="@item.ProdutoId" class="btn btn-soft btn-sm">@Html.Raw(Icones.Get("mais"))<span>Repor estoque</span></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
