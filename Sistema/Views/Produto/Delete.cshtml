@model Sistema.Models.Produto

@{
    ViewData["Title"] = "Excluir produto";
}

<div class="page-header">
    <div>
        <h1>Excluir produto</h1>
        <p class="page-sub">Essa ação não pode ser desfeita.</p>
    </div>
</div>

<div class="panel form-card">
    <dl class="row mb-3" style="font-size: 14px;">
        <dt class="col-sm-3 text-muted fw-normal">Produto</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3 text-muted fw-normal">Estoque</dt>
        <dd class="col-sm-9">@Model.Estoque</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="ProdutoId" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Excluir produto</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
