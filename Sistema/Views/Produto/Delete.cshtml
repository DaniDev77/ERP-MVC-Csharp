@using System.Globalization
@model Sistema.Models.Produto

@{
    ViewData["Title"] = "Excluir produto";
    var pt = new CultureInfo("pt-BR");
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Excluir produto", Descricao = "Confira os dados antes de confirmar.",
    VoltarTexto = "Produtos", VoltarUrl = Url.Action("Index") }' />

@* Card de confirmação em tom de alerta *@
<div class="ui-card danger-card confirm-card">
    <div class="object-header">
        <partial name="_ProdutoThumb" model='new ProdutoThumb { Nome = Model.Name, Tamanho = "thumb-lg" }' />
        <div class="object-header-texto">
            <h2>@Model.Name</h2>
            <div class="object-header-meta">
                <span>@Html.Raw(Icones.Get("tipos"))@(Model.TipoProduto?.TipoNome ?? "Sem tipo")</span>
                <span>@Html.Raw(Icones.Get("fornecedores"))@(Model.Fornecedor?.FonecedorNome ?? "Sem fornecedor")</span>
            </div>
        </div>
    </div>

    <dl class="detail-grid">
        <div><dt>@Html.Raw(Icones.Get("texto"))@Html.DisplayNameFor(m => m.Descricao)</dt><dd>@Model.Descricao</dd></div>
        <div><dt>@Html.Raw(Icones.Get("moeda"))@Html.DisplayNameFor(m => m.Preco)</dt><dd class="num">@Model.Preco.ToString("C2", pt)</dd></div>
        <div><dt>@Html.Raw(Icones.Get("caixa"))@Html.DisplayNameFor(m => m.Estoque)</dt><dd class="num">@Model.Estoque un.</dd></div>
    </dl>

    <div class="danger-zone" role="alert">
        @Html.Raw(Icones.Get("alerta"))
        <div>
            <strong>Esta ação não pode ser desfeita.</strong>
            <p>O produto <b>@Model.Name</b> será removido do cadastro.</p>
        </div>
    </div>

    <form asp-action="Delete" class="ui-card-footer mt-4">
        <input type="hidden" asp-for="ProdutoId" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-danger">@Html.Raw(Icones.Get("excluir"))<span>Excluir produto</span></button>
    </form>
</div>
