@model Sistema.Models.Produto

@{
    ViewData["Title"] = "Novo produto";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Novo produto", Descricao = "Preencha os dados e a quantidade inicial em estoque.",
    VoltarTexto = "Produtos", VoltarUrl = Url.Action("Index") }' />

@* Formulário em card com seções; ações no rodapé do card *@
<form asp-action="Create" class="ui-card form-card">
    @await Html.PartialAsync("_Form", Model)
    <div class="ui-card-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">@Html.Raw(Icones.Get("ok"))<span>Salvar produto</span></button>
    </div>
</form>
