@model IEnumerable<Sistema.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<h1>Produtos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo produto</a>
    <a asp-action="EstoqueBaixo" class="btn btn-outline-danger">Estoque baixo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.TipoProduto)</th>
            <th>@Html.DisplayNameFor(m => m.Fornecedor)</th>
            <th>@Html.DisplayNameFor(m => m.Preco)</th>
            <th>@Html.DisplayNameFor(m => m.Estoque)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.TipoProduto?.TipoNome</td>
                <td>@item.Fornecedor?.FonecedorNome</td>
                <td>@item.Preco.ToString("C2")</td>
                @* Estoque em destaque quando está abaixo do mínimo *@
                <td class="@(item.Estoque <= Sistema.Models.Produto.EstoqueMinimo ? "text-danger fw-bold" : "")">@item.Estoque</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProdutoId">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.ProdutoId">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
