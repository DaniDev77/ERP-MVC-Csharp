@model Sistema.Models.DesempenhoViewModel

@{
    ViewData["Title"] = "Meu desempenho";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Meu desempenho", Descricao = "Somente as vendas registradas por você.", Icone = "desempenho",
    AcaoTexto = "Registrar venda", AcaoUrl = Url.Action("Create", "Venda") }' />

<partial name="_Desempenho" model="Model" />

@if (Model.QtdVendas == 0)
{
    <div class="ui-card">
        <partial name="_EmptyState" model='new EmptyState {
            Imagem = "~/img/vazio-carrinho.svg", Titulo = "Nenhuma venda neste período",
            Texto = "Suas vendas aparecem aqui assim que forem registradas.",
            AcaoTexto = "Registrar venda", AcaoUrl = Url.Action("Create", "Venda"), Compacto = true }' />
    </div>
}
