@model List<Sistema.Models.Pedido>
@using System.Globalization
@{
    ViewData["Title"] = "Meus pedidos";
    var pt = new CultureInfo("pt-BR");
}

@* Novo (back-end, HF-001): o cliente acompanha os próprios pedidos e cancela os pendentes. Visual provisório *@
<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Meus pedidos", Descricao = "Seus pedidos ficam pendentes até a loja confirmar. Enquanto estiver pendente, você pode cancelar.",
    Icone = "recibo", AcaoTexto = "Fazer compra", AcaoUrl = Url.Action("Create", "Compra"), AcaoIcone = "carrinho" }' />

<div class="ui-card table-card">
    @if (!Model.Any())
    {
        <partial name="_EmptyState" model='new EmptyState {
            Imagem = "~/img/vazio-carrinho.svg", Titulo = "Você ainda não fez pedidos",
            Texto = "Escolha os produtos e envie o pedido. A loja confirma e você acompanha por aqui.",
            AcaoTexto = "Fazer compra", AcaoUrl = Url.Action("Create", "Compra"), AcaoIcone = "carrinho" }' />
    }
    else
    {
        <div class="table-wrap">
            <table class="table-ui table-stack" id="tabelaMeusPedidos">
                <thead>
                    <tr>
                        <th scope="col">Pedido</th>
                        <th scope="col">Itens</th>
                        <th scope="col" class="num">Total</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="acoes-col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr id="pedido-@p.PedidoId">
                            <td class="cell-head">
                                <span class="cell-title">Nº @p.PedidoId</span>
                                <span class="cell-sub"><time datetime="@p.DataHora.ToString("yyyy-MM-ddTHH:mm")">@p.DataHora.ToString("dd/MM/yyyy 'às' HH:mm")</time></span>
                            </td>
                            <td data-label="Itens">
                                @foreach (var i in p.Itens)
                                {
                                    <div class="cell-sub">@i.Quantidade × @(i.Produto?.Name ?? "Produto")</div>
                                }
                            </td>
                            <td data-label="Total" class="num fw-semibold">@p.Total.ToString("C2", pt)</td>
                            <td data-label="Status">
                                @Html.Raw(Pilulas.StatusPedido(p.Status))
                                @if (p.DataDecisao != null)
                                {
                                    <span class="cell-sub">em @p.DataDecisao.Value.ToString("dd/MM 'às' HH:mm")</span>
                                }
                                @if (p.Status == StatusPedido.Recusado && !string.IsNullOrEmpty(p.Motivo))
                                {
                                    <span class="cell-sub">Motivo: @p.Motivo</span>
                                }
                            </td>
                            <td class="acoes-col">
                                @if (p.Status == StatusPedido.Pendente)
                                {
                                    <form asp-action="Cancelar" asp-route-id="@p.PedidoId" method="post">
                                        <button type="submit" class="btn btn-ghost-danger btn-sm" aria-label="Cancelar o pedido @p.PedidoId">@Html.Raw(Icones.Get("fechar"))<span>Cancelar</span></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
