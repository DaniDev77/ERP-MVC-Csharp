@model List<Sistema.Models.Pedido>
@using System.Globalization
@{
    ViewData["Title"] = "Meus pedidos";
    var pt = new CultureInfo("pt-BR");
    // Novo (direção D): o subtítulo diz quantos pedidos há e quantos ainda esperam a loja (contagem, não dinheiro)
    var aguardando = Model.Count(p => p.Status == StatusPedido.Pendente);
    var subtitulo = Model.Count == 0
        ? "Seus pedidos ficam pendentes até a loja confirmar. Enquanto estiver pendente, você pode cancelar."
        : $"{Model.Count} {(Model.Count == 1 ? "pedido" : "pedidos")}"
          + (aguardando > 0 ? $" · {aguardando} aguardando a loja" : "")
          + ". Enquanto um pedido estiver pendente, você pode cancelar.";
}

@* Direção D (HF-001): cada pedido do cliente vira um recibo, com o status escrito, a hora da decisão e o motivo da loja *@
<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Meus pedidos", Descricao = subtitulo,
    Icone = "recibo", AcaoTexto = "Fazer compra", AcaoUrl = Url.Action("Create", "Compra"), AcaoIcone = "carrinho" }' />

@if (!Model.Any())
{
    @* Vazio com o caminho para a primeira compra *@
    <section class="ui-card recibos-vazio">
        <partial name="_EmptyState" model='new EmptyState {
            Imagem = "~/img/vazio-carrinho.svg", Titulo = "Você ainda não fez pedidos",
            Texto = "Escolha os produtos em Fazer compra. O pedido aparece aqui e fica aguardando até a loja confirmar.",
            AcaoTexto = "Fazer compra", AcaoUrl = Url.Action("Create", "Compra"), AcaoIcone = "carrinho" }' />
    </section>
}
else
{
    @* Lista de recibos (uma coluna de até 760px). O id tabelaMeusPedidos fica no contêiner e cada pedido mantém pedido-N.
       role="list": o list-style none faz o Safari/VoiceOver não anunciar a lista *@
    <ol class="recibos" id="tabelaMeusPedidos" role="list">
        @foreach (var p in Model)
        {
            var enviado = p.DataHora.ToString("dd/MM 'às' HH:mm");
            var decidido = p.DataDecisao?.ToString("dd/MM 'às' HH:mm");
            <li class="ui-card recibo" id="pedido-@p.PedidoId">
                <div class="recibo-cab">
                    <div class="recibo-cab-texto">
                        <h2 class="recibo-titulo">Pedido nº @p.PedidoId</h2>
                        @* Linha do tempo: quando foi enviado e, se já houve decisão, quando (DataDecisao) *@
                        <p class="recibo-sub num">
                            @if (p.Status == StatusPedido.Pendente)
                            {
                                <text>Enviado em @enviado. A loja ainda vai confirmar ou recusar.</text>
                            }
                            else if (decidido != null)
                            {
                                <text>Enviado em @enviado · @(p.Status == StatusPedido.Cancelado ? "cancelado por você" : p.Status == StatusPedido.Confirmado ? "confirmado" : "recusado") em @decidido</text>
                            }
                            else
                            {
                                <text>Enviado em @enviado</text>
                            }
                        </p>
                    </div>
                    @* Direção D: o status vem escrito na visão do cliente. Pendente é a etiqueta amarela ("Aguardando a loja");
                       Confirmado e Recusado usam o selo do Pilulas.cs; Cancelado é o selo neutro "Cancelado por você" *@
                    @if (p.Status == StatusPedido.Pendente)
                    {
                        <span class="pill pill-alerta">Aguardando a loja</span>
                    }
                    else if (p.Status == StatusPedido.Cancelado)
                    {
                        <span class="pill">Cancelado por você</span>
                    }
                    else
                    {
                        @Html.Raw(Pilulas.StatusPedido(p.Status))
                    }
                </div>

                @* Motivo da loja só em Recusado, inteiro e quebrando linha, sem pre-line (HF-006) *@
                @if (p.Status == StatusPedido.Recusado)
                {
                    <p class="motivo"><span class="motivo-rot">Motivo da loja</span>@(string.IsNullOrEmpty(p.Motivo) ? "A loja não informou o motivo." : p.Motivo)</p>
                }

                @* Direção D (RD12 e R7): preço congelado no pedido (i.PrecoUnitario), valor da linha em i.Subtotal (B4) e o total
                   gravado pelo servidor (p.Total). Nada de dinheiro é somado ou multiplicado aqui *@
                <ul class="recibo-itens" role="list" aria-label="Itens do pedido nº @p.PedidoId">
                    @foreach (var i in p.Itens)
                    {
                        <li class="recibo-item">
                            <div>
                                <p class="recibo-item-nome">@(i.Produto?.Name ?? "Produto")</p>
                                <p class="recibo-item-sub">@i.Quantidade × @i.PrecoUnitario.ToString("C2", pt)</p>
                            </div>
                            <p class="recibo-item-valor">@i.Subtotal.ToString("C2", pt)</p>
                        </li>
                    }
                </ul>
                <p class="recibo-total"><span>Total, com os preços do dia do pedido</span><strong class="num">@p.Total.ToString("C2", pt)</strong></p>

                @if (p.Status == StatusPedido.Pendente)
                {
                    @* Direção D (RD10): cancelar pede confirmação num details nativo (funciona sem JS). O form fica dentro do details:
                       POST com anti-forgery (form tag helper), asp-route-id e só em Pendente. O summary alterna dois spans (R6) e o
                       botão final começa pelo texto visível (WCAG 2.5.3) *@
                    <details class="cancelar">
                        <summary class="btn btn-outline-danger"><span class="fechado">Cancelar o pedido</span><span class="aberto">Manter o pedido</span></summary>
                        <form asp-action="Cancelar" asp-route-id="@p.PedidoId" method="post" class="cancelar-painel">
                            <p>A loja deixa de analisar o pedido nº @p.PedidoId. Para comprar de novo, faça um novo pedido.</p>
                            <button type="submit" class="btn btn-danger">Cancelar o pedido nº @p.PedidoId</button>
                        </form>
                    </details>
                }
            </li>
        }
    </ol>
}
