@model Sistema.Models.Fonecedor

@{
    ViewData["Title"] = "Editar fornecedor";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Editar fornecedor", VoltarTexto = "Fornecedores", VoltarUrl = Url.Action("Index") }' />

<form asp-action="Edit" class="ui-card form-card">
    <div class="object-header">
        <span class="avatar avatar-lg" style="--h: @Visual.Matiz(Model.FonecedorNome)" aria-hidden="true">@Visual.Iniciais(Model.FonecedorNome)</span>
        <div class="object-header-texto">
            <h2>@Model.FonecedorNome</h2>
            <div class="object-header-meta"><span>@Html.Raw(Icones.Get("documento"))<span class="mono">@Model.CNPJ</span></span></div>
        </div>
    </div>

    @* O código fica oculto: é ele que identifica o fornecedor ao salvar *@
    <input type="hidden" asp-for="FonecedorId" />
    <partial name="_Form" model="Model" />

    <div class="ui-card-footer">
        <a asp-action="Delete" asp-route-fonecedorid="@Model.FonecedorId" class="btn btn-ghost-danger esquerda-btn">@Html.Raw(Icones.Get("excluir"))<span>Excluir</span></a>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">@Html.Raw(Icones.Get("ok"))<span>Salvar alterações</span></button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
