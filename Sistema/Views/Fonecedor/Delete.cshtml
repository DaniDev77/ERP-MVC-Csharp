@model Sistema.Models.Fonecedor

@{
    ViewData["Title"] = "Excluir fornecedor";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Excluir fornecedor", Descricao = "Confira os dados antes de confirmar.",
    VoltarTexto = "Fornecedores", VoltarUrl = Url.Action("Index") }' />

@* Card de confirmação em tom de alerta *@
<div class="ui-card danger-card confirm-card">
    <div class="object-header">
        <span class="avatar avatar-lg" style="--h: @Visual.Matiz(Model.FonecedorNome)" aria-hidden="true">@Visual.Iniciais(Model.FonecedorNome)</span>
        <div class="object-header-texto">
            <h2>@Model.FonecedorNome</h2>
            <div class="object-header-meta"><span>@Html.Raw(Icones.Get("documento"))<span class="mono">@Model.CNPJ</span></span></div>
        </div>
    </div>

    <dl class="detail-grid">
        <div><dt>@Html.Raw(Icones.Get("texto"))@Html.DisplayNameFor(m => m.FonecedorDescricao)</dt><dd>@Model.FonecedorDescricao</dd></div>
        <div><dt>@Html.Raw(Icones.Get("telefone"))@Html.DisplayNameFor(m => m.FonecedorTelefone)</dt><dd>@Model.FonecedorTelefone</dd></div>
        <div><dt>@Html.Raw(Icones.Get("email"))@Html.DisplayNameFor(m => m.FonecedorEmail)</dt><dd>@Model.FonecedorEmail</dd></div>
    </dl>

    <div class="danger-zone" role="alert">
        @Html.Raw(Icones.Get("alerta"))
        <div>
            <strong>Esta ação não pode ser desfeita.</strong>
            <p>O fornecedor <b>@Model.FonecedorNome</b> será removido do cadastro.</p>
        </div>
    </div>

    <form asp-action="Delete" class="ui-card-footer mt-4">
        <input type="hidden" asp-for="FonecedorId" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-danger">@Html.Raw(Icones.Get("excluir"))<span>Excluir fornecedor</span></button>
    </form>
</div>
