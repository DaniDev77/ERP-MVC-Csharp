@model Sistema.Models.Fonecedor

@{
    ViewData["Title"] = "Novo fornecedor";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Novo fornecedor", Descricao = "Cadastre quem abastece a loja com produtos.",
    VoltarTexto = "Fornecedores", VoltarUrl = Url.Action("Index") }' />

<form asp-action="Create" class="ui-card form-card">
    <partial name="_Form" model="Model" />
    <div class="ui-card-footer">
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        <button type="submit" class="btn btn-primary">@Html.Raw(Icones.Get("ok"))<span>Salvar fornecedor</span></button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
