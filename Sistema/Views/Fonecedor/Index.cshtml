@model IEnumerable<Sistema.Models.Fonecedor>

@{
    ViewData["Title"] = "Fornecedores";
}

<div class="page-header">
    <div>
        <h1>Fornecedores</h1>
        <p class="page-sub">Quem abastece a loja com produtos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Novo fornecedor</a>
</div>

@if (!Model.Any())
{
    <div class="panel"><p class="mb-0 text-muted">Nenhum fornecedor cadastrado.</p></div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(m => m.FonecedorNome)</th>
                    <th>@Html.DisplayNameFor(m => m.FonecedorDescricao)</th>
                    <th>@Html.DisplayNameFor(m => m.CNPJ)</th>
                    <th>@Html.DisplayNameFor(m => m.FonecedorTelefone)</th>
                    <th>@Html.DisplayNameFor(m => m.FonecedorEmail)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FonecedorNome</td>
                        <td>@item.FonecedorDescricao</td>
                        <td>@item.CNPJ</td>
                        <td>@item.FonecedorTelefone</td>
                        <td>@item.FonecedorEmail</td>
                        <td class="text-end row-actions">
                            <a asp-action="Edit" asp-route-fonecedorid="@item.FonecedorId">Editar</a>
                            <span class="text-muted mx-1">·</span>
                            <a asp-action="Details" asp-route-fonecedorid="@item.FonecedorId">Detalhes</a>
                            <span class="text-muted mx-1">·</span>
                            <a asp-action="Delete" asp-route-fonecedorid="@item.FonecedorId">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
