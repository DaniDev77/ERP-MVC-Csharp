@model Sistema.Models.Fonecedor

@{
    ViewData["Title"] = "Detalhes do fornecedor";
}

<partial name="_PageHeader" model='new PageHeader {
    Titulo = "Fornecedor", VoltarTexto = "Fornecedores", VoltarUrl = Url.Action("Index") }' />

@* Ficha: cabeçalho do objeto (avatar, nome, CNPJ) e a grade de informações *@
<div class="ui-card confirm-card">
    <div class="object-header">
        <span class="avatar avatar-xl" style="--h: @Visual.Matiz(Model.FonecedorNome)" aria-hidden="true">@Visual.Iniciais(Model.FonecedorNome)</span>
        <div class="object-header-texto">
            <h1>@Model.FonecedorNome</h1>
            <div class="object-header-meta">
                <span>@Html.Raw(Icones.Get("documento"))<span class="mono">@Model.CNPJ</span></span>
                <span class="chip chip-brand">Fornecedor</span>
            </div>
        </div>
    </div>
    <dl class="detail-grid">
        <div><dt>@Html.Raw(Icones.Get("texto"))@Html.DisplayNameFor(m => m.FonecedorDescricao)</dt><dd>@Model.FonecedorDescricao</dd></div>
        <div><dt>@Html.Raw(Icones.Get("telefone"))@Html.DisplayNameFor(m => m.FonecedorTelefone)</dt><dd>@Model.FonecedorTelefone</dd></div>
        <div><dt>@Html.Raw(Icones.Get("email"))@Html.DisplayNameFor(m => m.FonecedorEmail)</dt><dd><a href="mailto:@Model.FonecedorEmail">@Model.FonecedorEmail</a></dd></div>
    </dl>
    <div class="ui-card-footer">
        <a asp-action="Delete" asp-route-fonecedorid="@Model.FonecedorId" class="btn btn-ghost-danger esquerda-btn">@Html.Raw(Icones.Get("excluir"))<span>Excluir</span></a>
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        <a asp-action="Edit" asp-route-fonecedorid="@Model.FonecedorId" class="btn btn-primary">@Html.Raw(Icones.Get("editar"))<span>Editar</span></a>
    </div>
</div>
