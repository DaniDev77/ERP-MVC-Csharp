@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Redefinir senha";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

@* Redefinição de senha a partir do link recebido *@
<span class="bubble bubble-solid bubble-lg mb-4 d-grid" aria-hidden="true">@Html.Raw(Icones.Get("chave"))</span>
<h1>Crie uma nova senha</h1>
<p class="auth-sub">Use no mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo.</p>

<form method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <input asp-for="Input.Code" type="hidden" />
    <div>
        <label asp-for="Input.Email" class="form-label">E-mail</label>
        <div class="input-icon">
            @Html.Raw(Icones.Get("email"))
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="voce@empresa.com" />
        </div>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Input.Password" class="form-label">Nova senha</label>
        <div class="input-icon">
            @Html.Raw(Icones.Get("cadeado"))
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
        </div>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Input.ConfirmPassword" class="form-label">Confirme a nova senha</label>
        <div class="input-icon">
            @Html.Raw(Icones.Get("cadeado"))
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Redefinir senha</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
