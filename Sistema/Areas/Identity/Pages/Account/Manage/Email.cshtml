@page
@model EmailModel
@{
    ViewData["Title"] = "E-mail";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

@* E-mail de acesso: atual (com selo de confirmado) e troca por um novo *@
<div class="ui-card-header">
    <div>
        <h2 class="ui-card-title">@ViewData["Title"]</h2>
        <p class="ui-card-sub">O e-mail que você usa para entrar no sistema.</p>
    </div>
</div>
<form id="email-form" method="post">
    <div class="ui-card-body">
        <partial name="_StatusMessage" for="StatusMessage" />
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <div class="form-grid" style="max-width: 480px">
            <div>
                <div class="auth-linha">
                    <label asp-for="Email" class="form-label">E-mail atual</label>
                    @if (Model.IsEmailConfirmed)
                    {
                        <span class="chip chip-success mb-2">Confirmado</span>
                    }
                </div>
                <div class="input-icon">
                    @Html.Raw(Icones.Get("email"))
                    <input asp-for="Email" class="form-control" disabled />
                </div>
                @if (!Model.IsEmailConfirmed)
                {
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link btn-sm px-0 mt-1">Enviar e-mail de verificação</button>
                }
            </div>
            <div>
                <label asp-for="Input.NewEmail" class="form-label">Novo e-mail</label>
                <div class="input-icon">
                    @Html.Raw(Icones.Get("email"))
                    <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="novo@empresa.com" />
                </div>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="ui-card-footer">
        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">Alterar e-mail</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
