@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar senha";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

@* Troca de senha: senha atual, nova e confirmação *@
<div class="ui-card-header">
    <div>
        <h2 class="ui-card-title">@ViewData["Title"]</h2>
        <p class="ui-card-sub">Use no mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo.</p>
    </div>
</div>
<form id="change-password-form" method="post">
    <div class="ui-card-body">
        <partial name="_StatusMessage" for="StatusMessage" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="form-grid" style="max-width: 440px">
            <div>
                <label asp-for="Input.OldPassword" class="form-label">Senha atual</label>
                <div class="input-icon">
                    @Html.Raw(Icones.Get("cadeado"))
                    <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Input.NewPassword" class="form-label">Nova senha</label>
                <div class="input-icon tem-acao">
                    @Html.Raw(Icones.Get("chave"))
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                    <button type="button" class="input-acao" data-senha-alternar aria-controls="Input_NewPassword" aria-pressed="false" aria-label="Mostrar senha">
                        <span data-icone-senha="mostrar">@Html.Raw(Icones.Get("olho"))</span>
                        <span data-icone-senha="ocultar" hidden>@Html.Raw(Icones.Get("olho-off"))</span>
                    </button>
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirme a nova senha</label>
                <div class="input-icon">
                    @Html.Raw(Icones.Get("chave"))
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="ui-card-footer">
        <button type="submit" class="btn btn-primary">Atualizar senha</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
