@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Senha redefinida";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

@* Senha trocada com sucesso *@
<img class="auth-ilustra" src="~/img/tudo-certo.svg" alt="" width="180" height="128" />
<h1>Senha redefinida</h1>
<p class="auth-sub">Pronto! Agora é só entrar com a nova senha.</p>
<a class="btn btn-primary btn-lg w-100" asp-page="./Login">Entrar</a>
