@page
@model LoginModel

@{
    ViewData["Title"] = "Entrar";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

<h1 class="auth-title">Entrar</h1>
<p class="auth-sub">Use o e-mail e a senha da sua conta.</p>

<form id="account" method="post" class="auth-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">E-mail</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" autofocus placeholder="voce@empresa.com" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-baseline">
            <label asp-for="Input.Password" class="form-label">Senha</label>
            <a id="forgot-password" class="form-hint" asp-page="./ForgotPassword">Esqueci a senha</a>
        </div>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Sua senha" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="Input.RememberMe" class="form-check-input" />
        <label asp-for="Input.RememberMe" class="form-check-label">Manter conectado neste aparelho</label>
    </div>

    <button id="login-submit" type="submit" class="btn btn-primary btn-block w-100">Entrar</button>
</form>

<p class="auth-footer">
    Ainda não tem conta?
    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Criar conta</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
