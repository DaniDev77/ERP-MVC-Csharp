@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Esqueci a senha";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

@* Recuperação de senha: pede o e-mail da conta *@
<a class="voltar" asp-page="./Login">@Html.Raw(Icones.Get("seta"))<span>Voltar para entrar</span></a>
<span class="bubble bubble-solid bubble-lg mb-4 d-grid" aria-hidden="true">@Html.Raw(Icones.Get("chave"))</span>
<h1>Esqueceu a senha?</h1>
<p class="auth-sub">Informe o e-mail da sua conta para receber as instruções de redefinição.</p>

<form method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div>
        <label asp-for="Input.Email" class="form-label">E-mail</label>
        <div class="input-icon">
            @Html.Raw(Icones.Get("email"))
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="voce@empresa.com" autofocus />
        </div>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Enviar instruções</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
