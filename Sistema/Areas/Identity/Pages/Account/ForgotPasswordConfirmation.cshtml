@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Verifique seu e-mail";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

@* Confirmação do pedido de redefinição de senha *@
<img class="auth-ilustra" src="~/img/tudo-certo.svg" alt="" width="180" height="128" />
<h1>Pedido recebido</h1>
<p class="auth-sub">Se o e-mail estiver cadastrado, as instruções para redefinir a senha serão enviadas. Se não receber nada, fale com um administrador do sistema.</p>
<a class="btn btn-primary btn-lg w-100" asp-page="./Login">Voltar para entrar</a>
