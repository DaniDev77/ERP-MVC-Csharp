@page
@model LockoutModel
@{
    ViewData["Title"] = "Conta bloqueada";
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
}

@* Conta bloqueada por tentativas erradas (5 tentativas → 5 minutos, conforme o Program.cs) *@
<img class="auth-ilustra" src="~/img/acesso-negado.svg" alt="" width="180" height="124" />
<h1>Conta bloqueada por enquanto</h1>
<p class="auth-sub">Houve muitas tentativas de senha errada. Por segurança, aguarde alguns minutos e tente de novo.</p>
<div class="d-grid gap-2">
    <a class="btn btn-primary btn-lg" asp-page="./Login">Tentar novamente</a>
    <a class="btn btn-secondary btn-lg" asp-page="./ForgotPassword">Esqueci a senha</a>
</div>
